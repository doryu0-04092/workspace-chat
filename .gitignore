# 依存
node_modules/
.pnp/
.pnp.js

# ビルド成果物
dist/
build/
.vite/
*.tsbuildinfo

# 環境変数（値は絶対にコミットしない）
.env
.env.*
!.env.example

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# テスト・カバレッジ
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Prisma（生成物）
**/generated/

# Terraform
# .terraform.lock.hcl は意図的に無視しない。プロバイダのバージョンとチェックサムを
# 固定するファイルであり、追跡しないと手元・CI・本番で違うプロバイダが入りうる。
.terraform/
*.tfstate
*.tfstate.*
# *.tfvars は末尾一致のため prod.tfvars.example には一致しない。
# .env と違い、例示ファイルを打ち消す行（!*.tfvars.example）は要らない。
*.tfvars
crash.log
override.tf
override.tf.json

# IDE / エディタ
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# アップロードの一時領域（ローカル開発用）
uploads/
tmp/

# テストレポート（CI では Artifact として残す）
reports/
