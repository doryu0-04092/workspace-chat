// Prisma のスキーマ。
//
// このファイルが定義するのは **認証・ワークスペース・チャンネルの土台と、チャンネルのメッセージとスレッドとメンションの対象と、本文の検索の索引**である。
// 添付は別のイシューで扱う。
//
// ============================================================================
// このファイルを直す人へ: **Prisma の記法で書けない制約が9つある**
// ============================================================================
//
// 部分一意索引（`WHERE` 付き）・式に対する索引（`lower(...)`）・検査制約（CHECK）は
// Prisma のスキーマ言語に無い。
// **マイグレーションの SQL に直接書いてある。** 具体的には次の9つ。
//
//   1. `User_userId_lower_key`                 … ユーザーID の一意性は大文字小文字を区別しない
//   2. `Membership_single_owner_per_workspace` … 1ワークスペースにオーナーは1人
//   3. `RecoveryCode_single_unused_per_user`   … 未使用のリカバリーコードは1人1つ
//   4. `Channel_archive_naming_check`          … アーカイブと採番と改名が不可分
//   5. `Message_body_check`                    … 本文は 1〜4000 文字で、空白だけではない
//   6. `Message_replyCount_check`              … 返信件数は負にならない
//   7. `Dm_participants_check`                 … DM の当事者は小さい User.id が先で、自分自身ではない
//   8. `DmMessage_body_check`                  … DM の本文も 1〜4000 文字で、空白だけではない
//   9. `MessageReactionCount_count_check`      … リアクションの件数は 1 以上（0 になった絵文字の行は消す）
//
// **このファイルだけを見ても、この9つは見えない。** モデルを増減させるときは
// `prisma/migrations/` の SQL も併せて読むこと。9つとも
// `apps/api/src/prisma-schema.test.ts` が実際の PostgreSQL に対して検証している。
//
// 代償: 上の9つは `prisma migrate dev` の自動生成では復元されない。
// スキーマを作り直すときは手で書き足す必要がある。
// 採らなかった側（制約をアプリ側の実装だけで守る）の代償は、
// **片方だけ実行された状態を DB が受け入れてしまう**ことである。
// 認可と整合性の根拠をアプリ側だけに置かない（CLAUDE.md 2）。

datasource db {
  provider = "postgresql"
  // **接続先はここに書けない。** Prisma 7 は datasource の `url` を廃止した。
  // 接続先はリポジトリの根の prisma.config.ts が渡す。
}

// 生成物は追跡しない（.gitignore の `**/generated/**`）。
// **生成は `npm run typecheck` と `npm run build` の前に走る**（ルートの package.json の
// `pretypecheck` / `prebuild`）。CI はその両方を実行するため、
// **生成器の設定が壊れていれば CI で落ちる。**
//
// `postinstall` に置かない。`npm ci --omit=dev`（apps/api/Dockerfile の prod-deps の段）でも `postinstall` は走る。
// `prisma` の CLI 自体は `@prisma/client` の任意の peer として lock 上 devOptional であり `--omit=dev` でも入るが、
// **依存を入れるだけの段で生成物を作ることになり、生成器の設定の失敗が install の失敗として出る。**
// 代償: `npm ci` しただけでは生成物ができない。**型を使う前に typecheck か build を
// 一度通す必要がある。** 生成を build の一部と見なす、という整理である。
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS の出力は CommonJS（apps/api/tsconfig.json）。
  // 生成物だけ ESM にすると、読み込む側で解決できない。
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// ============================================================================
// 列挙
// ============================================================================

/// ワークスペースにおける役割（要件定義書 3.5.1）。
/// オーナーは作成者に固定し、委譲もワークスペースの削除も行わない（3.4）。
enum WorkspaceRole {
  OWNER
  MEMBER
}

/// チャンネルの公開範囲（機能一覧 F-10）。
/// **PRIVATE の可視性は ChannelMember の有無で決まる。** この列だけでは決まらない。
enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

/// 通知の種類（F-26。機能一覧 10.3）。**いまはメンションだけ**。DM（F-19）の通知はここに足す。
enum NotificationKind {
  MENTION
}

// ============================================================================
// 利用者
// ============================================================================

model User {
  /// 主キーはすべて UUIDv7（要件定義書 3.5.2）。
  ///
  /// **連番を用いないのは、連番そのものが「その資源が存在すること」を漏らすため**である。
  /// 生成は Prisma 側で行う。PostgreSQL 17 には組み込みの `uuidv7()` が無く
  /// （18 で追加）、DB 側の関数に依存すると 17 では動かない（技術スタック）。
  /// UUIDv4 ではなく v7 を使うのは、**先頭が時刻順で索引の局所性を損なわない**ため。
  id String @id @default(uuid(7)) @db.Uuid

  /// ログイン識別子であり、メンションの `@` に続く識別子でもある（機能一覧 1.1）。
  /// 文書では「ユーザーID」と呼ぶ。
  ///
  /// **Prisma 側の名前だけを `loginId` にし、DB の列名は `userId` のまま
  /// （`@map`）にしてある。** マイグレーションの SQL も `docs/features.md` の記述も
  /// 変わらない。名前を分ける理由は次のとおり。
  ///
  /// `RecoveryCode` / `Membership` / `ChannelMember` の `userId` は
  /// **`User.id`（UUID）への外部キー**であり、これとは別物である。
  /// 生の SQL なら `uuid = character varying` で落ちて気づくが、
  /// **Prisma のクライアントでは両方とも TypeScript の `string` になり、
  /// 取り違えても型検査を素通りする。**
  ///
  ///     prisma.membership.findMany({ where: { userId: session.user.loginId } })
  ///
  /// のような取り違えは、例外も型エラーも出さず**静かに0件を返す。**
  /// 「参加者一覧が空」「所属ワークスペースが無い」という形でしか現れない。
  /// **この PR にはまだ実装が1行も乗っていないため、分けるなら今が最も安い。**
  ///
  /// **退会しても再利用させない**（機能一覧 1.5）。退会は論理削除であり行が残るため、
  /// この一意制約がそのまま再利用の禁止になる。**別途の予約表は要らない。**
  ///
  /// 長さの上限（30文字。機能一覧 1.1）は**列の型に入れる。**
  /// 要件が数値で決めているものを、アプリ側の検証だけに置かない。
  /// **検証を1箇所書き漏らせば、そのまま無制限の文字列が入る**（REVIEW.md 3 / CWE-770）。
  /// 下限（3文字）と文字種（英数字とアンダースコア）は列では表せないため、アプリ側で見る。
  ///
  /// **この `@unique` は、一意性の根拠ではない。** 既定の照合順序で作られるため
  /// `owner` と `Owner` を別物として通す。**一意性を担保しているのは、マイグレーションに
  /// 手書きした `User_userId_lower_key`（`lower("userId")` の一意索引）である**
  /// （機能一覧 1.1。2026-09-05 決定）。ここに `@unique` を残しているのは、
  /// **このファイルだけを読む人に「ユーザーID は一意である」が見えなくなるため**である。
  ///
  /// **照合する側も `lower()` で引くこと。** 列は登録時の綴りをそのまま保持するため、
  /// 素の等値比較では、登録時と違う綴りで引けない。
  ///
  /// **この照合は Prisma のクライアントでは書けない。**
  /// このファイルの冒頭に挙げた5つの制約と同じ理由である
  /// （Prisma のスキーマ言語・問い合わせ API に `lower(...)` の等値比較が無い）。
  ///
  ///   - `findUnique({ where: { loginId } })` は**完全一致**であり、
  ///     `User_userId_lower_key` を使わない。**書いた側からは「素の等値比較」だと
  ///     見分けがつかない。** 型検査も通る。症状はログインの失敗とメンションの不着で、
  ///     どちらも**理由が利用者に返らない**（機能一覧 1.2 / 9.1）
  ///   - `mode: 'insensitive'` は、PostgreSQL 向けに **`ILIKE` を生成する**（Prisma の仕様）。
  ///     **`ILIKE` は `lower("userId")` の B-tree 式索引を使えない。**
  ///     結果は正しいが全表走査になり、利用者数に比例して遅くなる（REVIEW.md 5）。
  ///     **この遅さはこのリポジトリでは未計測である**（索引が使えないことは
  ///     式索引の性質であり、計測を要しない）
  ///
  /// **実装は `$queryRaw` で `lower("userId") = lower($1)` と書くこと。**
  /// 値はプレースホルダとして渡す（REVIEW.md 3 / CWE-89）。
  /// `nextArchiveSequence` / `visibleChannels` と同じ扱いである。
  ///
  /// **この雛形をそのまま写さないこと。`deletedAt` の扱いが経路ごとに違う。**
  /// 退会は論理削除でこの表の行が残るため、**素の照合は退会済みにも当たる。**
  ///
  ///   | 経路 | 退会済み | 落とすとどうなるか |
  ///   |---|---|---|
  ///   | ログイン（1.2） | **除く**（`AND "deletedAt" IS NULL`） | 退会したアカウントでログインできる |
  ///   | 招待（2.2） | **対象側にも要求する側にも当てる**（対象側: この照合に `AND "deletedAt" IS NULL`。要求する側: 招待するオーナーの所属の問い合わせに `user: { deletedAt: null }`。`invite` が通る `WorkspacesService.membershipOf`） | 対象側: 招待し直せて `Membership` が復活する。要求する側: 退会したオーナーが招待を通せる（機能一覧 1.4 の2段構えの1段目） |
  ///   | 復旧（1.1） | **除く** | **退会済みのパスワードを書き換えられる** |
  ///   | メンション（9.1。経路1: 投稿時の宛先解決） | **対象側にも要求する側にも当てる**（対象側: `WHERE ... AND u."deletedAt" IS NULL`。要求する側: `JOIN "User" viewer ... AND viewer."deletedAt" IS NULL`） | 対象側: 消し込みを取りこぼすと、退会済みが新しい宛先として解決される。要求する側: 退会した利用者が宛先解決を求められる。**理由と経緯は機能一覧 9.1 の経路1 にある** |
  ///   | メンションの補完候補（9.1。前方一致） | **経路1 と同じく、対象側にも要求する側にも当てる** | 対象側: 退会済みが候補に出る。要求する側: 消し込みを取りこぼした退会済みの利用者が、候補を引ける。参照実装は `apps/api/src/prisma-schema.test.ts` の `mentionCandidatesByPrefix`（**`LIKE` ではなく `starts_with` で比べる**——`_` はユーザーID の文字であり、`LIKE` のワイルドカードでもある） |
  ///   | 新規登録の重複判定（1.1） | **含める**（`deletedAt` を条件にしない。1.5 の「ユーザーID は再利用させない」） | 退会済みのユーザーID を空いていると判定し、`INSERT` が `User_userId_lower_key` の一意制約違反で落ちる——再利用は DB が止めるが、応答が「既に使われている」にならない |
  ///   | 検索の `from:@ユーザーID`（12.1） | **含める**（対象側に `deletedAt` を条件にしない。要求する側は所属の確認〔`membershipOf`〕とメッセージの問い合わせの両方で除く。`search.service.ts`） | `deletedAt IS NULL` を付けると、1.5 が残すと決めた退会した利用者の過去のメッセージを `from:` で引けなくなる |
  ///   | 検索の種別「ユーザー」（12.1） | **除く**（そのワークスペースの `Membership` を持ち `deletedAt IS NULL`。参加者一覧〔2.1〕と同じ） | 退会済みがユーザーの結果に出る |
  ///
  /// **復旧の経路は特に注意する。** 1.5 の「削除後、リカバリーコードによる
  /// 再設定もできない」を支えているのは「退会処理が同一トランザクションで
  /// `usedAt` を埋める」という規約だけであり、**退会処理が1件でも
  /// 取りこぼせば通ってしまう。** 読み取り側にも条件を置いて二重にする。
  /// この経路差は `apps/api/src/prisma-schema.test.ts` が固定している。
  loginId String @unique @map("userId") @db.VarChar(30)

  /// 上限（50文字）は機能一覧 1.1 / 1.3 の決定（2026-09-11・依頼側）。loginId と同じ理由で列の型に入れる。
  displayName String @db.VarChar(50)

  /// **Argon2id のハッシュだけを入れる列**（要件定義書 4.3）。
  /// 平文・可逆暗号の列は作らない。ハッシュ化も照合も `apps/api/src/auth/secret-hash.ts` の
  /// `hashSecret` / `verifySecret` を通す（#245。**NFC への正規化がその中にある**——`argon2.verify` を直接呼ぶと、
  /// 端末によって登録と違うコードポイント列で送られた利用者がログインできなくなる）。
  passwordHash String

  /// プロフィール（機能一覧 1.3）。未設定を許すため任意にする。
  ///
  /// `statusText` の上限（100文字）は loginId と同じ理由で列の型に入れる。
  ///
  /// **`avatarUrl` には上限を置かない。**
  /// 機能一覧が数値を定めていないためである。**根拠の無い数字を列に焼き付けると、
  /// 後から変えるのにマイグレーションが要る。** 上限を決めたらここに入れる。
  ///
  /// **代償**（CLAUDE.md 4）**: この列は DB が止めない。**
  /// `loginId` / `statusText` / `displayName` と違い、**アプリ側の検証を1箇所書き漏らせば、
  /// そのまま無制限の文字列が入る**（REVIEW.md 3 / CWE-770）。
  /// しかも `avatarUrl` は**メッセージ一覧を返すたびに載る列**であり、
  /// 影響は保存量だけに留まらない。**上限を決めるなら機能一覧 1.3 に承認を得て記し、
  /// ここに `@db.VarChar(n)` を置くこと。**
  /// `Workspace.name` / `Channel.name` / `Channel.baseName` は扱いが違う: 上限は決めた
  /// （1〜50 コードポイント。決定・2026-09-12・依頼側。#290）が、**列には置かず入力の仕様で縛る**
  /// （アーカイブの接尾辞のぶん保存される名前が長くなるため。`Channel.name` の説明を参照）。
  ///
  /// **`statusEmoji` は理由が違う。** 機能一覧 1.3 は「ステータスは**絵文字1つ**と
  /// テキスト（最大100文字）で構成される」と**数を定めている。**
  /// それでも列に置かないのは、**「絵文字1つ」を文字数で表せない**ためである。
  /// ZWJ による連結や異体字セレクタで、1つの絵文字が複数のコードポイントになる。
  /// `VARCHAR(n)` に置き換えると、n をいくつにしても
  /// **正しい絵文字を弾くか、絵文字でない文字列を通すかのどちらかになる。**
  /// よってアプリ側で見る。**「機能一覧に数値が無い」を理由にしない。**
  ///
  /// **`statusEmoji` と `statusText` は1セットである**（機能一覧 1.3。決定・2026-09-12・依頼側。#283）。
  /// **両方そろえて書き、消すときは両方消す。片方だけの行を作らない。** DB では縛っておらず（CHECK は置いていない）、
  /// 守っているのは `apps/api/src/users/profile.service.ts` の書き込みだけである。この2列に書く経路を足すなら、同じ規約で書くこと。
  /// 読む側は両方入っているときだけステータスとして返す（片方だけの行は無しとして扱う）。
  ///
  /// **`avatarUrl` に入れるのは、アップロードの確定でサーバーが組み立てた配信 URL のパス
  /// （`/avatars/{uid}/{UUID}/{ファイル名}`）だけである**（機能一覧 1.3）。**利用者が渡した URL を入れない**——
  /// 入れると、形式の検証と配信ヘッダーを通っていない画像を表示することになる。
  avatarUrl   String?
  statusEmoji String?
  statusText  String? @db.VarChar(100)

  /// スレッド内の未読を、チャンネルの未読に含めるか（F-23。機能一覧 10.1。**既定は含める**）。
  ///
  /// **代償: 利用者の設定をこの表の列として持っている。** 通知の設定（F-24・F-25）が増えたら、
  /// 利用者の設定は別の表へ移すこと（移す時点で、この列は新しいマイグレーションで落とす）。
  ///
  /// **切り替えても既読位置は動かさない**（一括で既読扱いにしない。要件定義書 3.5.2）——
  /// 「含めない」→「含める」で、過去の未読の返信が未読として現れる側を採っている。
  ///
  /// **この値を変えるのは `PATCH /api/users/me/settings` だけである**（#509。機能一覧 10.1）。
  /// **プロフィール（`PATCH /api/users/me`）には混ぜない**——プロフィールが持つのは他人に見える情報であり、
  /// 設定は本人にしか返さない。**切り替えても既読位置は動かさない**（上の段のとおり）。
  threadUnreadIncluded Boolean @default(true)

  /// 退会（F-36）。**物理削除は行わない**（要件定義書 3.4）。
  ///
  /// 代償: **利用者が「削除した」と認識した内容も DB に残り続ける。**
  /// 過去のメッセージを残して会話の文脈を保つことと引き換えである。
  /// 実運用で削除の求めに応じるには、物理削除の仕組みが別途要る（要件定義書 6.2）。
  ///
  /// **この列を埋めるだけでは足りない。** 退会は論理削除でこの行が残るため、
  /// **`User` を参照する `ON DELETE CASCADE` はどれも発火しない。**
  /// 退会の処理は、**同一トランザクションで次の2つを行うこと**（機能一覧 1.5）。
  ///
  ///   1. 未使用の `RecoveryCode` を無効化する（`usedAt` を埋める）。
  ///      でないと**退会済みのアカウントを復旧できてしまう**
  ///   2. その利用者の `Membership` を消す。**`ChannelMember` は複合外部キーで
  ///      連鎖して消える**（`Membership.channelMembers` を参照）。
  ///      でないと**退会した利用者が参加者一覧と配信の対象に残り続ける**
  ///
  /// **どちらも DB は止めない。アプリ側が守る規約である。**
  ///
  /// **3つ目は認可の入口にある。** トークンから利用者を解決する時点で
  /// `deletedAt IS NULL` を確かめ、**退会済みのトークンは読み取り・書き込みを問わず
  /// すべての API と WebSocket イベントで拒否すること**（機能一覧 1.4。#90）。
  /// **上の2つと、1.4 の「可視性を判定する問い合わせ」だけでは書き込み経路が塞がらない**——
  /// 1.5 のリフレッシュトークンの失効が止めるのは**再発行だけ**であり、
  /// **失効前のアクセストークンでメッセージ投稿・リアクション・招待の承諾が通る。**
  /// 代償: 2 により、**退会後に「誰がいたか」を追えない**（物理削除の代償が退会にも及ぶ）。
  ///
  /// **その前に、オーナーの退会そのものを拒否すること**（機能一覧 1.5）。
  /// 2 をそのまま実行すると、**そのワークスペースはオーナーが0人になる。**
  /// `Membership_single_owner_per_workspace` は重複を止める索引であって、
  /// **不在は止めない。** オーナー権限の委譲もワークスペースの削除も対象外のため
  /// （要件定義書 3.4）、0人になったワークスペースは**二度と管理できなくなる。**
  /// **この拒否もアプリ側が守る規約である。DB は止めない。**
  deletedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// **この列だけは DB が担保しない。**
  ///
  /// `@updatedAt` は **Prisma のクライアント経由の更新でしか作用しない。**
  /// マイグレーションが作るのは `DEFAULT CURRENT_TIMESTAMP` だけであり、
  /// **更新時に値を進めるトリガは無い。**
  ///
  /// このスキーマは、一意性・検査制約・連鎖削除をすべて DB に置いている。
  /// **この列はその方針から外れる唯一のものである**（CLAUDE.md 4）。
  /// 代償: **生 SQL の `UPDATE` では据え置かれる。**
  ///
  /// トリガを置かなかった理由: **現時点でこの列に依存する要求が1つも無い。**
  /// 置くなら `BEFORE UPDATE` のトリガを手書きし、このファイル冒頭の
  /// 「Prisma の記法で書けない制約」の一覧を5つから6つに増やすことになる。
  /// **この列を根拠に何かを判定する要求が出たら、その時点で見直すこと。**
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  memberships         Membership[]
  recoveryCodes       RecoveryCode[]
  refreshTokens       RefreshToken[]
  /// ピン留めした（F-33）。
  pinnedMessages      MessagePin[]
  /// 自分宛ての未承諾の招待（F-38）と、自分が出した招待（F-08）。
  invitationsReceived Invitation[]     @relation("InvitationInvitee")
  invitationsSent     Invitation[]     @relation("InvitationInviter")
  messages            Message[]
  mentionedIn         MessageMention[]
  /// DM の当事者（F-19。`Dm` は User.id の小さい方と大きい方の2本で持つ）と、DM に書いたメッセージ。
  dmsAsLow            Dm[]             @relation("DmLowUser")
  dmsAsHigh           Dm[]             @relation("DmHighUser")
  dmMessages          DmMessage[]
  reactions           MessageReaction[]
  avatarUploads       AvatarUpload[]
  attachments         Attachment[]
  hereMentionedIn     HereMentionRecipient[]

  /// **`ChannelMember` への直接の関連は持たない。** チャンネル参加は
  /// ワークスペース参加（`Membership`）を経由してのみ成り立つ（`ChannelMember` を参照）。
}

/// パスワードを忘れたときの唯一の復旧手段（F-37）。
///
/// メール送信を行わない構成の帰結であり、**このコードを失えばアカウントは復旧できない**
/// （要件定義書 3.4）。その代償は登録画面に明示する。
model RecoveryCode {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// **Argon2id のハッシュだけを入れる列**（機能一覧 1.1）。コード自体は保存しない。
  ///
  /// ハッシュは毎回ソルトが変わるため、**この列に一意制約は置けない**し、
  /// 値による検索もできない。照合は userId で絞ってから1件ずつ検証する。
  codeHash String

  /// **無効化した時刻。** 使い捨てであり、使用したコードは無効化する（機能一覧 1.1）。
  ///
  /// **「使用した時刻」ではない。** 入る経路は2つある。
  ///
  ///   1. リカバリーコードで実際にパスワードを再設定した
  ///   2. **利用者が退会した**（機能一覧 1.5）。退会は論理削除で `User` の行が残るため、
  ///      `ON DELETE CASCADE` は働かない。**削除と同一トランザクションで
  ///      未使用のコードを無効化する**ことで、退会済みアカウントの復旧を止める
  ///
  /// **この列から「復旧が行われたか」は読み取れない。**
  /// `usedAt IS NOT NULL` を「復旧が行われた」と読む実装を書いてはならない。
  /// **退会しただけの利用者が「復旧した」ことになる。**
  /// この列を根拠にできるのは「**そのコードはもう使えない**」ことだけである。
  ///
  /// 代償: 真偽値ではなく時刻にした当初の利点（いつ復旧が行われたかが分かる）は、
  /// 2つ目の経路を入れた時点で失われた。**復旧の履歴が要るなら、別に記録が要る。**
  /// それでも時刻のままにしているのは、**「いつ無効化されたか」は依然として
  /// 追える**ためで、真偽値に落とすと分かることが減るだけだからである。
  usedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 照合は userId で絞り込む。索引が無いと利用者数に比例して遅くなる。
  @@index([userId])
}

/// リフレッシュトークン（F-02。機能一覧 1.2）。ログインで系列（`familyId`）を1つ作り、発行から1日を過ぎたトークンで
/// リフレッシュしたときに同じ系列の新しい行へ入れ替える（1日に1回。#303）。**入れ替え済みのトークンが出されたら、その系列をすべて失効させる**（RFC 9700 4.14.2）。
/// **期限切れ・失効から 30 日を過ぎた行は、その利用者のログインと入れ替えのたびに消す**（決定・2026-09-12・依頼側。#270・#303。`SessionService`）。
/// 使い続ける利用者の行は、使っている端末1台あたり約 30 行に収まる。使わなくなった利用者と退会済みの利用者の行は残る
/// （退会は失効させるだけで消さない。機能一覧 1.5）。
/// 30 日は期限切れ・失効のうち早く起きた方から数える（#312）。消えた行のトークンは再利用として検知されない
/// （検知の窓 = 早い側から 30 日。機能一覧 1.2 の代償）。
model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// ログイン1回ごとの系列。再利用を検知したときに、この値で系列ごと失効させる。
  /// **ログインでは渡さず、この既定値（UUIDv7。要件定義書 3.5.2）で作る。** 入れ替えでは元の行の値を引き継ぐ。
  familyId String @default(uuid(7)) @db.Uuid

  /// **トークンの SHA-256（16進 64 文字）だけを入れる列。** トークン自体は保存しない。
  /// 32 バイトの乱数であり総当たりが成り立たないため、パスワードと違って遅いハッシュ（Argon2id）を使わず、
  /// 値で引けるように一意にする（リクエストごとに照合するため）。
  tokenHash String @unique @db.Char(64)

  expiresAt DateTime @db.Timestamptz(3)

  /// 失効させた時刻（入れ替え・ログアウト・再利用の検知・退会）。**埋まっていれば使えない。**
  revokedAt DateTime? @db.Timestamptz(3)

  /// 発行した時刻。**発行から1日を過ぎたトークンでリフレッシュしたときに入れ替える**（#303）。
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

// ============================================================================
// ワークスペース
// ============================================================================

model Workspace {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  memberships Membership[]
  channels    Channel[]
  invitations Invitation[]
  dms         Dm[]

  /// ワークスペース名に一意制約を置かない。**誰でも作成できる**（要件定義書 3.5.1）以上、
  /// 名前を取り合う設計にすると、先に作った人が名前を占有する。
  /// 識別は id で行い、名前は表示のためのものとする。
  ///
  /// **名前は 1〜50 文字（コードポイント）・空白だけは不可**（決定・2026-09-12・依頼側。#290）。
  /// **上限は入力の仕様（openapi.yaml の `CreateWorkspaceRequest`）にだけ置き、この列には置かない**
  /// （チャンネル名と同じ扱い。`Channel.name` の説明を参照）。
}

/// ワークスペースへの参加（第1層。要件定義書 3.5.1）。
///
/// **オーナーを Workspace.ownerId として別に持たない。** 役割はこの表の `role` だけを
/// 根拠とする。2箇所に持つと、片方だけ更新された状態が生まれ、
/// **どちらが正しいかを実行時まで判定できない。**
///
/// 「オーナーが1人だけ」は部分一意索引 `Membership_single_owner_per_workspace` が
/// マイグレーションの SQL で担保する。
///
/// 代償: **「オーナーが0人のワークスペース」は DB だけでは禁止できない。**
/// 索引が止められるのは重複であって不在ではない。ワークスペースの作成時に、
/// オーナーの Membership を**同一トランザクションで**作る必要がある。
///
/// 招待の未承諾（F-38）はこの表では表さない。**この表は成立した参加だけを持つ。**
/// 承諾していない招待は参加ではなく、参加として持つと
/// 「所属していないのに一覧に出る」経路をこちらから作ることになる。
/// 招待そのものは `Invitation` が持つ（承諾で `Invitation` を消し、この表に行を作る。F-08 / F-38。#326）。
model Membership {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid
  userId      String @db.Uuid

  role WorkspaceRole

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// **この行が消えると、その利用者のチャンネル参加もすべて消える。**
  /// キック・退出が全チャンネルからの離脱になることを、DB が担保する。
  ///
  /// **ただし、退会（F-36）ではこの行は自動では消えない。** 退会は論理削除であり
  /// `User` の行が残るため、上の `onDelete: Cascade` が発火しないためである。
  /// **退会の処理が、同一トランザクションでこの行を消すこと**（機能一覧 1.5。
  /// `User.deletedAt` の説明を読むこと）。消さないと、
  /// **退会した利用者が参加者一覧と配信の対象に残り続ける。**
  channelMembers ChannelMember[]

  /// **既読位置（F-23）も、この行が消えると消える。** 参照先を `User` ではなくここにしているのは、
  /// **抜けた利用者の既読位置が残ると、復帰したときに抜けていた間の投稿が既読になる**ためである（機能一覧 10.1）。
  channelReads ChannelRead[]
  threadReads  ThreadRead[]
  dmReads      DmRead[]

  /// 通知（F-26）も、この行が消えると消える（ワークスペースから外れた利用者に、そのワークスペースの通知を残さない）。
  notifications Notification[]

  /// 同じ利用者が同じワークスペースに二重に参加しないこと。
  /// この索引は「そのワークスペースの参加者一覧」の取得にも効き、
  /// `ChannelMember` の複合外部キーの参照先にもなる。
  @@unique([workspaceId, userId])
  /// 「その利用者が所属するワークスペースの一覧」（サイドバーの切替）に効く。
  @@index([userId])
}

/// ワークスペースへの招待（F-08 / F-38。機能一覧 2.2）。**承諾していない招待だけを持つ**——承諾したら消して `Membership` を作り、
/// 辞退したら消す（オーナーは再度招待できる）。**期限は持たない**（決定・2026-09-12・依頼側。#326。代償: 放置された招待はいつまでも残り、
/// ずっと後でも承諾できる）。
///
/// **同じワークスペースの同じ利用者への招待は1件だけ**（下の一意索引。2件目は 409 `already_invited`）。**既にメンバーの利用者は招待できない**
/// （409 `already_member`）が、`Membership` との排他は索引では表せないため、アプリが招待の前に確かめる。
/// **代償: その確認と承諾が重なると、メンバーでありながら未承諾の招待が残る**（機能一覧 2.2）。
model Invitation {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid

  /// 招待された利用者（`User.id`。ユーザーID〔`User.loginId`〕ではない）。
  inviteeId String @db.Uuid

  /// 招待したオーナー（`User.id`）。
  invitedById String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitee   User      @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, inviteeId])
  /// 「自分宛ての招待の一覧」に効く。
  @@index([inviteeId])
}

// ============================================================================
// チャンネル
// ============================================================================

/// チャンネル（第2層。要件定義書 3.5.1）。
///
/// ## アーカイブ時に名前へ採番する（提案・承認済。2026-09-04）
///
/// チャンネルは削除せずアーカイブする（F-35）。アーカイブしたチャンネルが名前を
/// 抱えたままだと、**同じ名前で新しいチャンネルを作れない。**
/// そこでアーカイブの時点で `name` を `baseName-<採番>` に変える。
///
/// **採番は二度と外れない。** アーカイブを解除しても元の名前には戻らない。
/// これにより `(workspaceId, name)` の一意制約を維持したまま、名前の衝突が
/// 構造的に起きなくなる。**ただしこれを DB は担保していない**
/// （`archiveSequence` の説明を読むこと）。
///
/// **復元した行は「採番済みだが archivedAt が null」という形になる。**
/// これは異常ではなく、復元されたチャンネルの正しい姿である。
/// 採番の有無を「アーカイブ中かどうか」の判定に使ってはならない。**判定は archivedAt で行う。**
///
/// **代償を記録する**（CLAUDE.md 4）。
///
/// 1. **アーカイブを解除しても名前が戻らないため、利用者からは「別のチャンネルに
///    なった」ように見える。** 復元は名前の復元ではない
/// 2. **過去のメンションやリンク、外部に共有された参照が指す名前と、現在の名前がずれる。**
///    参照が id で解決されていれば辿れるが、名前で書かれたものは辿れない
///
/// アーカイブ・採番・改名の3つが同時に起きることは、検査制約
/// `Channel_archive_naming_check` がマイグレーションの SQL で担保する。
/// **アプリ側の実装に委ねると、片方だけ実行された状態が作れてしまう。**
model Channel {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid

  /// 現在の名前。アーカイブすると `baseName-<archiveSequence>` に変わる。
  ///
  /// **列に長さの上限を置かない。** 入力の上限は 50 コードポイント（機能一覧 3.1。#290）だが、
  /// アーカイブの接尾辞 `-<採番>` はその外側に付くため、保存される名前は 50 を超える
  /// （`loginId` / `statusText` とはここが違う）。
  ///
  /// **ただし「上限が無い」という意味ではない。** この列は一意索引
  /// `Channel_workspaceId_name_key`（B-tree）に載っており、
  /// **B-tree の索引タプルには約 2704 バイトの上限がある。**
  /// 超える名前の INSERT は
  /// `index row size ... exceeds btree version 4 maximum 2704 for index` で落ちる。
  /// **アプリ側の検証を通り抜けた入力が、400 ではなく 500 になる。**
  ///
  /// **この事実上の上限は文字数では表せない。** 索引タプルの値は行の外に出せない
  /// （TOAST できない）が、インラインでの圧縮は効くため、**同じ文字数でも中身によって
  /// 通ったり落ちたりする。** 実測（`apps/api/src/prisma-schema.test.ts`）では、
  /// 同じ 6000 文字でも `x` の繰り返しは通り、乱数の16進文字列は落ちる。
  ///
  /// よって **チャンネル名の長さはアプリ側で先に弾くこと。**
  ///
  /// **上限は「接尾辞を付けても収まる長さ」で決めること。**
  /// アーカイブは名前を `baseName-<archiveSequence>` に変えるため数バイト伸びる。
  /// **INSERT は通るのにアーカイブの UPDATE だけが落ちる名前が存在する。**
  /// 改名の機能は無いため、**そのチャンネルは永久にアーカイブできない**（F-35 は Must）。
  /// `archiveSequence` が `MAX + 1` を却下したのとまったく同じ形の失敗である。
  /// この帰結は `apps/api/src/prisma-schema.test.ts` が固定している
  /// （上限の数値は焼き付けず、入る最大の長さを実際に探してから確かめている）。
  /// **数値の上限は 50 コードポイントと決めた**（機能一覧 3.1。決定・2026-09-12・依頼側。#290）。
  /// **列には置かず、入力の仕様で縛る**（接尾辞つきの名前が入るため）。チャンネルの実装で当てること。
  ///
  /// `displayName` / `Workspace.name` にこの問題は起きない。**索引に載っていない。**
  name String

  /// 作成時に付けられた名前。採番の基底として使う。
  ///
  /// この列を持つのは、**採番の基底を name から文字列で切り出さないため**である。
  /// 切り出す方式では、利用者が `report-1` という名前を自分で付けた場合と、
  /// `report` をアーカイブして採番された場合を区別できない。
  ///
  /// 代償: 列が1つ増え、**作成時に name と baseName へ同じ値を書く必要がある。**
  /// ずれると採番の基底が狂う。ずれていないことは `Channel_archive_naming_check` が見る
  /// （採番されていない行は `name = baseName` でなければ通らない）。
  ///
  /// **この列を変えないことは、DB では担保していない。** 検査制約が禁じるのは
  /// name と baseName の**食い違い**だけであり、両方を同時に書き換える更新は通る。
  /// 通せば採番の基底が別の名前に移り、元の名前の採番列が飛ぶ。
  /// **これはアプリ側が守る規約である。**
  ///
  /// 止める制約を置かなかった理由: **チャンネルの改名機能を持たない**ため、
  /// 現時点で到達する経路が無い。止めるには行の更新前後を比べるトリガが要り、
  /// 到達経路の無い問題のために仕組みを1つ増やすことになる。
  /// **改名機能を足すときは、この判断を見直すこと。**
  ///
  /// 長さの上限を置かないのは name と同じ理由である。**この列自体は索引に載らないが、
  /// 検査制約が name = baseName（または `baseName-<採番>`）を要求するため、
  /// name の事実上の上限がそのままこの列にも及ぶ。** 上の name の説明を参照。
  baseName String

  visibility ChannelVisibility

  /// アーカイブした時刻（F-35）。null なら現役。
  ///
  /// **この列を読んで、人を増やす・メッセージを書くかを決める経路（参加・招待・投稿・返信・編集・削除）は、読む前にその行を掴むこと。**
  /// 掴まずに読むと、アーカイブの確定の直前に読んだ古い値に基づいて、アーカイブの後に参加・招待・投稿・返信・編集・削除が成立する。
  /// DB の制約はこれを止めない。実装は apps/api/src/workspaces/channel-access.ts の `lockedChannelFor`（行を強さ `share` で掴んでから読む）を使う。
  archivedAt DateTime? @db.Timestamptz(3)

  /// 同じ基底名の中での通し番号。**一度アーカイブされた行が持つ。**
  /// 復元しても外れないため、**現役の行が持っていることもある**（上の説明を参照）。
  ///
  /// **既にこの列を持つ行を再びアーカイブするときは、採番も改名も行わない。**
  /// 規則をそのまま当てると、**自分自身が `general-1` を占有しているため 2 が選ばれ、
  /// 名前が `general-2` に変わる。** アーカイブと復元を繰り返すたびに番号が進み、
  /// 名前がずれ続ける。検査制約はこれを止めない（据え置きも採番し直しも通る）。
  /// 採番するのは**この列がまだ null の行だけ**である。
  ///
  /// 次の番号は「**その基底名で、名前がまだ空いている最小の番号**」とする。
  /// **`MAX(archiveSequence) + 1` にしてはならない。** チャンネル名に制限は無いため、
  /// 利用者が自分で `general-1` を作れる。その状態で `general` をアーカイブすると
  /// MAX + 1 は 1 を選び、**名前が衝突してアーカイブ自体が失敗する。**
  /// 改名の機能は無いため、そのチャンネルは**永久にアーカイブできない**（F-35 は Must）。
  ///
  /// 採番の最中に、選んだ番号と同じ名前（`baseName-<番号>`）のチャンネルが並行して作られると、名前の一意制約の違反になる。
  /// **一意制約違反を捕まえて番号を選び直し、やり直すこと。**
  /// アーカイブどうしが同じ名前を選んで衝突することは無い——まだ番号を持たない行は検査制約で `name = baseName` のため、
  /// 同じ基底名の未採番の行はワークスペースに1つしか無く、同じ行の同時のアーカイブは下の行のロックで順番に処理される。
  ///
  /// **この列を読む前に、その行を `SELECT … FOR UPDATE` で掴むこと。** 掴まずに読むと、
  /// 読みと更新のあいだに別の要求の採番と復元が確定し、**番号を持つ行を採番し直す。**
  /// 検査制約も一意制約もこれを止めない（採番し直した名前は空いているため、上のやり直しにも掛からない）。
  /// 実装は apps/api/src/workspaces/channel-row-lock.ts の `lockChannelRow`（強さ `update`）を読む前に呼ぶ。
  ///
  /// 番号の選び方を確かめる問い合わせは apps/api/src/prisma-schema.test.ts にある。
  /// **そのまま写さないこと。** テストは固定の文字列を連結しており、
  /// **baseName は利用者が付けた名前で `'` を含められる。**
  /// 実装ではプレースホルダとして渡す（REVIEW.md 3 / CWE-89）。
  ///
  /// **「採番が二度と外れない」ことは、DB では担保していない。**
  /// 検査制約が禁じるのは採番と名前の**食い違い**だけであり、
  /// `archiveSequence` と `name` を同時に戻す更新
  /// （`archiveSequence = NULL, name = baseName`）は通る。
  /// 元の名前が空いていれば一意制約にも触れない。
  /// **baseName の不変性と同じく、これはアプリ側が守る規約である。**
  ///
  /// 止める制約を置かなかった理由も baseName と同じである。
  /// **採番を外す経路（アーカイブの取り消し）を機能として持たない**ため、
  /// 現時点で到達しない。止めるには行の更新前後を比べるトリガが要り、
  /// 到達経路の無い問題のために仕組みを1つ増やすことになる。
  /// **アーカイブを取り消せる機能を足すときは、この判断を見直すこと。**
  archiveSequence Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// **この列だけは DB が担保しない。** 理由と代償は `User.updatedAt` に書いた。
  /// アーカイブ（採番と改名）と復元は Prisma のクライアントで更新しており、`updatedAt` は進む。
  /// **生 SQL で行を更新する経路を足すと、その経路では据え置かれる。**
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ChannelMember[]
  messages  Message[]
  /// 添付ファイルのアップロード（F-27）。チャンネルを消せば行も消える（S3 のオブジェクトは残る）。
  attachments Attachment[]
  /// 既読位置（F-23）。チャンネルを消せば既読位置も消える。
  reads     ChannelRead[]

  /// 通知（F-26）。チャンネルを消せば通知も消える。
  notifications Notification[]

  /// ワークスペース内で名前は一意。**ワークスペースをまたげば同じ名前を使える。**
  /// 一意制約の範囲が広すぎないことは、テストが別ワークスペースへの作成で確かめている。
  ///
  /// **採番（workspaceId, baseName, archiveSequence）に別の一意制約は置かない。**
  /// 検査制約 `Channel_archive_naming_check` により、name は
  /// `baseName-<archiveSequence>` に一意に決まる。**採番が重複すれば名前も必ず重複する**ため、
  /// この一意制約だけで採番の重複も止まる。置いても届く場面が無く、
  /// テストで到達できない制約が1つ増えるだけになる。
  ///
  /// **`@@index([workspaceId])` も置かない。** この一意索引は先頭列が workspaceId の
  /// B-tree であり、「チャンネル一覧をワークスペース単位で引く」問い合わせにそのまま使える。
  /// 単独の索引は問い合わせ能力を1つも足さず、書き込みのたびの索引更新と容量だけを増やす。
  @@unique([workspaceId, name])
  /// **一意性のためではない。** id は主キーであり、これだけで一意である。
  /// `ChannelMember` の複合外部キー `(channelId, workspaceId)` の**参照先として要る**
  /// （PostgreSQL は一意制約の無い列の組を外部キーの参照先にできない）。
  @@unique([id, workspaceId])
}

/// チャンネルへの参加（第2層）。
///
/// **プライベートチャンネルの可視性の根拠はこの表である**（CLAUDE.md 2）。
/// 画面でボタンを隠すことは権限の根拠にならない。一覧・検索・ファイル配信・
/// WebSocket 配信のすべてが、この表との結合で参加者を判定する。
///
/// オーナーであっても、この表に行が無ければプライベートチャンネルの中身は見えない
/// （要件定義書 3.5.1 / 4.4）。**オーナーの権限は人の出入りの管理であって、
/// 会話の閲覧ではない。**
///
/// ## 参照先は User ではなく Membership である
///
/// **チャンネル参加は、ワークスペース参加の上にしか成り立たない。**
/// `userId` から `User` を直接参照すると、**ワークスペースからキック・退出した
/// 利用者の行がこの表に残り続ける。** この表だけで可視性を判定する実装がそれを拾えば、
/// **キックされた利用者がプライベートチャンネルを読み続けられる**
/// （機能一覧 2.2 の受け入れ条件「所属していた全チャンネルから自動的に外れる」
/// 「そのワークスペースのデータに一切アクセスできなくなる」が成立しない）。
///
/// そこで `workspaceId` を持たせ、`(workspaceId, userId)` で `Membership` を参照する。
/// **キック・退出（Membership の削除）が、そのまま全チャンネルからの離脱になる。**
/// 同時に、**ワークスペース外の利用者をプライベートチャンネルに招待できなくなる**
/// （機能一覧 2.2）。どちらもアプリ側の実装ではなく DB が担保する。
///
/// 代償: 列が1つ増え、`Channel` に `@@unique([id, workspaceId])` が要る
/// （複合外部キーの参照先には一意制約が要る）。主キーがある以上この索引は
/// 一意性の役には立たず、**参照先として使うためだけに存在する。**
///
/// 代償（削除の扱い）: **この表と `Membership` は物理削除である。**
/// 退出・キックの履歴は残らず、**「いつ誰が抜けたか」を後から追えない。**
/// 論理削除にすれば追えるが、可視性の判定すべてに「抜けていないこと」の条件が増え、
/// **1箇所でも書き漏らすと、抜けた利用者に見え続ける。** 追跡可能性より、
/// 判定を単純に保つことを採った（機能一覧 2.2）。
model ChannelMember {
  /// 複合主キー（channelId, userId）にせず、UUIDv7 の代理キーを置く。
  /// 主キーの形を全モデルでそろえるためであり、
  /// **「この表だけ例外」を覚えておく必要をなくす**（要件定義書 3.5.2）。
  id String @id @default(uuid(7)) @db.Uuid

  channelId String @db.Uuid

  /// チャンネルが属するワークスペース。**channelId から導けるが、あえて持つ。**
  /// 下の2本の複合外部キーの両方に要るためであり、
  /// 食い違いは `ChannelMember_channelId_workspaceId_fkey` が拒否する。
  workspaceId String @db.Uuid

  userId String @db.Uuid

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  /// チャンネルとワークスペースの組が実在すること。**食い違いを許さない。**
  channel Channel @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  /// **その利用者がそのワークスペースに参加していること。**
  /// User を直接参照しない。参照先を Membership にすることで、
  /// キック・退出がこの表まで連鎖する。
  membership Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  /// 二重参加を防ぐ。この索引は「そのチャンネルの参加者一覧」にも効く。
  @@unique([channelId, userId])
  /// **可視性の判定はこの向きで引く**（「この利用者が参加しているチャンネル」）。
  /// 索引が無いと、チャンネル一覧のたびに全走査になる。
  @@index([userId])
}

/// チャンネルのメッセージとスレッドの返信（F-11・F-13・F-17。機能一覧 4.1・4.2・6）。
model Message {
  /// UUIDv7。一覧のカーソル（`before`）にそのまま使う。
  id String @id @default(uuid(7)) @db.Uuid

  channelId String @db.Uuid

  /// **チャンネルと同じワークスペース。** 複合外部キーで、別のワークスペースのチャンネルを指せない。
  workspaceId String @db.Uuid

  /// 投稿者。**退会しても行は残る**（利用者は論理削除。機能一覧 1.5）。
  authorId String @db.Uuid

  /// 1〜4000 文字で、空白だけではない（検査制約 `Message_body_check`。マイグレーションに置く）。
  body String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// 最後に編集した時刻。編集していなければ null（「編集済み」の表示。機能一覧 4.2）。
  editedAt DateTime? @db.Timestamptz(3)

  /// 削除した時刻（論理削除）。**削除しても本文は残す**（要件定義書 3.4・機能一覧 4.2）。返さないのは応答と配信の側である。
  deletedAt DateTime? @db.Timestamptz(3)

  /// スレッドの親（F-17。機能一覧 6）。チャンネルの本体のメッセージなら null。
  /// **親は同じチャンネルのメッセージだけ**（複合外部キー）。**返信に返信はできない**（1階層のみ）——親が返信でないことは書く側が確かめる。
  parentId String? @db.Uuid

  /// 削除されていない返信の件数（カウンタ列。一覧で `COUNT` を発行しない。返信の投稿・削除と同じトランザクションで増減する。要件定義書 4.1）。
  replyCount Int @default(0)

  /// 本文に `@channel` があるか（F-21。機能一覧 9.2。投稿・返信・編集で本文から決める）。
  /// **参加者全員のメンションの件数に数える**（F-24。`unread.ts`）——参加者ごとの行を作らない（参加した時点より後だけを数える条件がそのまま効く）。
  mentionsChannel Boolean @default(false)

  /// 本文に `@here` があるか（F-21）。**メンションの件数に数えるのは、受け取りを返した利用者だけ**（`HereMentionRecipient`）。
  /// 編集で本文から消えたら数えない（受け取りの記録は残す）。
  mentionsHere Boolean @default(false)

  channel  Channel          @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// 親は論理削除だけで消える（返信は残す。機能一覧 4.2）。チャンネルごと消えるときは、同じ文の中で返信も消えるため NoAction にする。
  parent   Message?         @relation("Thread", fields: [parentId, channelId], references: [id, channelId], onDelete: NoAction)
  replies  Message[]        @relation("Thread")
  mentions MessageMention[]
  reactions      MessageReaction[]
  reactionCounts MessageReactionCount[]
  /// 投稿に結び付けた添付（F-27）。
  attachments Attachment[]
  hereRecipients HereMentionRecipient[]

  /// 既読位置（F-23）から指される向き。**参照するだけで、このメッセージの側からは読まない。**
  /// Prisma が双方向の関連を要求するために置いている（3本とも `ChannelRead` / `ThreadRead` の側が持ち主である）。
  readAsChannelLast ChannelRead[]
  readAsThreadParent ThreadRead[] @relation("ThreadReadParent")
  readAsThreadLast   ThreadRead[] @relation("ThreadReadLast")
  /// ピン留め（F-33）。**1件のメッセージに1つまで**（`MessagePin.messageId` の一意制約）。リストにしているのは、参照先が複合キー（id, channelId）で
  /// Prisma が1対1の関連に同じ組の一意制約を求めるためである（`messageId` だけで一意なので、組の一意索引は足さない）。
  pins               MessagePin[]

  /// 通知（F-26）から指される向き。`Notification` の側が持ち主である。
  notifications Notification[]

  /// 返信の親を、同じチャンネルのメッセージに限る複合外部キーの参照先。
  @@unique([id, channelId])
  /// **未読の集計はこの向きで引く**（`channelId = ?` と、**本体（`parentId IS NULL`）についての** `id > 既読位置`。F-23。機能一覧 10.1）。
  /// **上の `@@index([channelId, parentId, id])` では代わりにならない**——2列目が `parentId` のため、
  /// チャンネルの中を `id` で切る条件が前方一致にならない。
  ///
  /// **返信はこの範囲では切れない。** 未読の述語は `(m."parentId" IS NOT NULL OR m."id" > 既読位置)` であり、
  /// 左枝が id によらず返信を全部通すためである（返信を切るのは `ThreadRead` の `NOT EXISTS` の側。
  /// 束5 で採った形の帰結であり、誤りではない。#505 第7巡の 🟡1）。
  @@index([channelId, id])
  /// **チャンネルの一覧（本体だけ。`parentId IS NULL`）と、スレッドの返信の一覧（`parentId` で絞る）は、どちらもこの向きで引く**
  /// （新しい順・`before` より古いもの）。**踏むと壊れる: 返信を引く問い合わせは必ず `channelId` を伴う**——`parentId` だけで引くと、この索引の前方を使えない。
  @@index([channelId, parentId, id(sort: Desc)])
  /// **検索（F-30。機能一覧 12.1）の本文の照合はこの索引で引く**（pg_bigm の 2-gram。`LIKE likequery(語)`）。
  /// **拡張 `pg_bigm` はマイグレーションの SQL が作る**（Prisma のスキーマでは宣言していない）。
  @@index([body(ops: raw("gin_bigm_ops"))], map: "Message_body_bigm_idx", type: Gin)
}

/// メンションの対象（F-20。機能一覧 9.1）。投稿・返信のときに、本文の `@ユーザーID` を投稿時の宛先解決（経路1）で解決できた利用者を持つ。
/// **編集では、本文にユーザーID が残っている対象を経路1 で解決し直さずに残す**（チャンネルを抜けた・退会した対象も残る）。本文から消えた対象だけを外し、
/// まだ保存していない `@` だけを経路1 で解決して足す（`MessagesService` の `replaceMentions`）。**新しく足す行は、経路1 が返した利用者だけである**。
/// **表示時の参照先解決（経路2）は、この表の `userId` から `User` を引く**——`ChannelMember` を条件にしないため、対象がチャンネルを抜けても退会しても引ける。
model MessageMention {
  /// UUIDv7 の代理キー（主キーの形を全モデルでそろえる。要件定義書 3.5.2）。
  id String @id @default(uuid(7)) @db.Uuid

  messageId String @db.Uuid

  /// 対象の利用者（`User.id`。ログイン識別子の `User.loginId` ではない）。
  /// **`Membership` や `ChannelMember` を参照しない**——参照すると、キック・退出でメンションが消え、本文の `@` が誰を指したかを引けなくなる。
  userId String @db.Uuid

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// 利用者は論理削除で行が残る（機能一覧 1.5）。
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 本文に同じ利用者を2回書いても1件。メッセージの対象を引く向きにも効く。
  ///
  /// 未読とメンションの集計（F-23・F-24。`unread.ts` の `MENTIONS_PARTICIPANT`）は、この表を `EXISTS` で引く（1つの未読の行につき高々1行にするため、
  /// `LEFT JOIN` しない）。
  @@unique([messageId, userId])
}

/// リアクション（F-18。機能一覧 7）。**誰がどの絵文字を付けたか**の1件。件数は `MessageReactionCount` に持つ。
/// 絵文字は Unicode の RGI_Emoji に当たる列1つ（アプリ側で確かめる。`User.statusEmoji` と同じ理由で列の長さでは縛らない）。
/// **削除済みのメッセージの行も消さない**（削除は論理削除。応答で返さないだけである）。
model MessageReaction {
  /// UUIDv7 の代理キー（主キーの形を全モデルでそろえる。要件定義書 3.5.2）。付けた順にも使う。
  id String @id @default(uuid(7)) @db.Uuid

  messageId String @db.Uuid

  /// 付けた利用者（`User.id`）。**`ChannelMember` を参照しない**——参照すると、チャンネルを抜けたときに行だけが連鎖で消え、
  /// カウンタ列（`MessageReactionCount.count`）と食い違う。
  userId String @db.Uuid

  emoji String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// 利用者は論理削除で行が残る（機能一覧 1.5）。
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// **同じ人が同じ絵文字を二重に付けられない**（機能一覧 7）。メッセージの行を引く向きにも効く。
  @@unique([messageId, userId, emoji])
}

/// リアクションの件数（カウンタ列。F-18。要件定義書 4.1「リアクション数はカウンタ列として保持し、本体の更新と同一トランザクションで増減させる」）。
/// **一覧で `COUNT` を発行しない**ためにある。メッセージと絵文字の組で1行。**件数は 1 以上**で、0 になったら行を消す
/// （検査制約 `MessageReactionCount_count_check`。マイグレーションに置く）。
///
/// **踏むと壊れる: `MessageReaction` の行を足す・消す経路は、同じトランザクションでここを増減させる**（`reactions.service.ts`）。
/// 増減はメッセージの行を `FOR UPDATE` で掴んでから行う——同じメッセージの付け外しを直列にし、件数の読み書きと種類の上限の判定を食い違わせない。
model MessageReactionCount {
  /// UUIDv7 の代理キー。**その絵文字を初めて付けた順**（応答の並び）にも使う。
  id String @id @default(uuid(7)) @db.Uuid

  messageId String @db.Uuid

  emoji String

  count Int

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji])
}

/// `@here` の送った宛先と受け取り（F-21。機能一覧 9.2「タスクをまたぐ在席」）。
/// **送った宛先ごとに1行**を持ち、受け取りを返した利用者は `receivedAt` を持つ——
/// **送った宛先の一覧は全行、受け取りの一覧は `receivedAt` のある行**であり、一致しないときも両方が残る（届いていないかもしれない利用者を後から確かめる記録）。
/// **`@here` の通知（メンションの件数）は、`receivedAt` のある行の利用者にだけ数える**（`unread.ts`）。
/// **読む API は持たない**（誰が確かめられるかは、作るときにそのチャンネルの参加者の範囲で決める。9.2）。
model HereMentionRecipient {
  /// UUIDv7 の代理キー（主キーの形を全モデルでそろえる。要件定義書 3.5.2）。
  id String @id @default(uuid(7)) @db.Uuid

  messageId String @db.Uuid

  /// 送った宛先の利用者（`User.id`）。**送る時点でそのチャンネルの参加者と確かめた利用者だけ**を書く（5.2）。
  userId String @db.Uuid

  /// 受け取りを返した時刻。期限までに返らなかった宛先は null（受け取らなかったとして扱う）。
  receivedAt DateTime? @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1つの `@here` の宛先に同じ利用者は1回。**未読の集計はこの組で引く**（1組に高々1行）。
  @@unique([messageId, userId])
}

// ============================================================================
// 既読位置（F-23。機能一覧 10.1）
// ============================================================================

/// チャンネルの既読位置（F-23。機能一覧 10.1）。**未読は、ここからの差分で求める**（都度集計しない）。
///
/// **位置は時刻ではなくメッセージの id で持つ。** 同じミリ秒に入った投稿の前後が時刻では決まらない。
/// id は UUIDv7 で作った順に増え、一覧の並び（`id` の降順）とも `Message` の索引とも同じ軸である。
///
/// **参照先は `ChannelMember` と同じ考え方で `Membership` である**（`User` を直接参照しない）。
/// **ワークスペースからのキック・退出（`Membership` の削除。F-37・F-38）では、これで既読位置も連鎖して消える。**
///
/// **踏むと壊れる: チャンネル単位のキック・退出（F-09・F-10）では連鎖しない。** 消えるのは `ChannelMember` だけであり、
/// **既読位置はアプリが同じトランザクションで消す**（`unread.ts` の `forgetReadPositions`）。
/// 残すと、再参加した利用者に**抜ける前の位置**が返り、「ここから未読」の線が参加前に引かれて未読数と食い違う
/// （未読数の側は `m."createdAt" >= cm."joinedAt"` が守る。#505 第2巡の 🔴1）。
/// **DM の既読位置（F-19）を足すときも、この2つの経路を両方とも見ること。**
///
/// **行が無い利用者の未読は、参加した時点（`ChannelMember.joinedAt`）より後だけを数える**
/// （参加する前の履歴を未読にしない）。この規約は DB では縛れず、問い合わせの側が守る。
model ChannelRead {
  /// UUIDv7 の代理キー（主キーの形を全モデルでそろえる。要件定義書 3.5.2）。
  id String @id @default(uuid(7)) @db.Uuid

  channelId String @db.Uuid

  /// チャンネルが属するワークスペース。`Membership` への複合外部キーに要る（`ChannelMember` と同じ）。
  workspaceId String @db.Uuid

  userId String @db.Uuid

  /// 最後に読んだメッセージの id。**戻さない**——古いページを遡っても既読は進んだままにする（10.1）。
  lastReadMessageId String @db.Uuid

  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  channel    Channel    @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  membership Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  /// 既読位置が指すメッセージ。**チャンネルごと消えるときは同じ文の中で消えるため NoAction にする**（`Message.parent` と同じ理由）。
  lastRead   Message    @relation(fields: [lastReadMessageId, channelId], references: [id, channelId], onDelete: NoAction)

  /// 利用者とチャンネルの組で1行。未読を引く向き（「この利用者のチャンネルごとの既読位置」）にも効く。
  @@unique([channelId, userId])
  @@index([userId])
}

/// スレッドの既読位置（F-23。機能一覧 10.1）。**チャンネルとは別系統で持つ**——
/// 「スレッド内の未読をチャンネルの未読に含めるか」を利用者が切り替えられ（`User.threadUnreadIncluded`）、
/// **切り替えた瞬間に集計対象が変わる**ためである（含めない側で読み進めても、チャンネルの既読位置は動かない）。
///
/// **切替時に一括で既読扱いにしない**（読んでいないものが読んだことになる。要件定義書 3.5.2）。
/// 参照先の考え方と、行が無いときの下限は `ChannelRead` と同じである。
model ThreadRead {
  id String @id @default(uuid(7)) @db.Uuid

  /// スレッドの親のメッセージ（返信は1階層のみ。`Message.parentId`）。
  parentMessageId String @db.Uuid

  /// 親が属するチャンネル。`Message` の複合一意 `(id, channelId)` を参照するために持つ。
  channelId String @db.Uuid

  workspaceId String @db.Uuid

  userId String @db.Uuid

  /// 最後に読んだ返信の id。
  lastReadMessageId String @db.Uuid

  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  membership Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  parent     Message    @relation("ThreadReadParent", fields: [parentMessageId, channelId], references: [id, channelId], onDelete: NoAction)
  lastRead   Message    @relation("ThreadReadLast", fields: [lastReadMessageId, channelId], references: [id, channelId], onDelete: NoAction)

  @@unique([parentMessageId, userId])
  @@index([userId])
}

// ============================================================================
// ダイレクトメッセージ（F-19。機能一覧 8）
// ============================================================================

/// 同じワークスペースの2人の DM（F-19。機能一覧 8）。**1対1のみ**（グループ DM は対象外。要件定義書 3.4）。
///
/// **DM はチャンネルではない**（機能一覧 5.2）。`Channel` / `Message` の行にしない——チャンネルの参加者判定・未読の集計・
/// 部屋の関門は `ChannelMember` を根拠にしており、DM を混ぜると、その判定が DM に流れ込む（8「チャンネルの判定を DM に流用しない」と同じ理由）。
/// **代償: リアクション（F-18）・検索（F-30）など、DM にも当てる機能は、この3つの表の側にも当て方を持つことになる。**
///
/// **同じ2人の DM は1つだけ**（8「同じ相手との DM は1つに集約される」）。当事者を **User.id の小さい方（`lowUserId`）と
/// 大きい方（`highUserId`）の順**で持ち、`(workspaceId, lowUserId, highUserId)` の一意索引で止める。
/// 順を逆にした行・自分自身との行は検査制約 `Dm_participants_check`（マイグレーションに置く）が止める——
/// 順を縛らないと、同じ2人の行が逆の順でもう1つ入り、一意索引をすり抜ける。
///
/// **当事者を `Membership` ではなく `User` で参照する。** 参照先を `Membership` にすると、キック・退出で DM とメッセージが連鎖して消え、
/// 「過去のメッセージは残る」（機能一覧 1.5・2.2）が DM で破れる。**その代わり、いまメンバーかは DB が縛らない**——
/// 読み書きと配信のたびに、アプリが `Membership` と `User.deletedAt` を確かめる（5.2 の DM の箇条。`apps/api/src/workspaces/dms.service.ts`）。
model Dm {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid

  /// 当事者のうち User.id の小さい方と大きい方（`Dm_participants_check`）。
  lowUserId  String @db.Uuid
  highUserId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lowUser   User        @relation("DmLowUser", fields: [lowUserId], references: [id], onDelete: Cascade)
  highUser  User        @relation("DmHighUser", fields: [highUserId], references: [id], onDelete: Cascade)
  messages  DmMessage[]
  reads     DmRead[]

  /// 同じ2人の DM は1つ。**「この利用者の DM の一覧」を小さい方の側から引く向き**にも効く（先頭2列）。
  @@unique([workspaceId, lowUserId, highUserId])
  /// `DmRead` の複合外部キー `(dmId, workspaceId)` の参照先（`Channel` の `@@unique([id, workspaceId])` と同じ理由）。
  @@unique([id, workspaceId])
  /// 「この利用者の DM の一覧」を大きい方の側から引く向き。
  @@index([workspaceId, highUserId])
}

/// DM のメッセージ（F-19。機能一覧 8）。**編集・論理削除の扱いはチャンネルのメッセージと同じ**（機能一覧 4.2。本文は削除しても残す）。
///
/// **書き手が当事者であることは DB では縛らない**（当事者は2列のどちらかで、外部キー1本で表せない）。書くのは `dms.service.ts` の投稿だけである。
model DmMessage {
  id   String @id @default(uuid(7)) @db.Uuid
  dmId String @db.Uuid

  /// 書き手。**退会しても行は残る**（機能一覧 1.5）。
  authorId String @db.Uuid

  /// 1〜4000 文字で、空白だけではない（検査制約 `DmMessage_body_check`。マイグレーションに置く）。
  body String

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  editedAt  DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  dm     Dm   @relation(fields: [dmId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// 既読位置から指される向き（`Message.readAsChannelLast` と同じく、参照するだけ）。
  readAsLast DmRead[]

  /// `DmRead` の既読位置を、同じ DM のメッセージに限る複合外部キーの参照先。
  @@unique([id, dmId])
  /// 一覧（新しい順・`before` より古いもの）と、未読の集計（`dmId = ?` と `id > 既読位置`）の両方をこの向きで引く。
  @@index([dmId, id(sort: Desc)])
}

/// DM の既読位置（「利用者 × DM」。F-23。機能一覧 10.1）。**考え方は `ChannelRead` と同じ**——位置はメッセージの id で持ち、戻さない。
///
/// **参照先は `Membership` である。** ワークスペースからのキック・退出・退会（`Membership` の削除）で連鎖して消える。
/// 残すと、戻ったときに抜けていた間の位置が返る（`ChannelRead` の説明と同じ）。DM にはチャンネル単位の抜け方が無いため、アプリが消す経路は無い。
///
/// **行が無い利用者の未読は、そのワークスペースに参加した時点（`Membership.joinedAt`）より後だけを数える**（抜けて戻った利用者に、抜ける前の履歴を未読にしない）。
model DmRead {
  id          String @id @default(uuid(7)) @db.Uuid
  dmId        String @db.Uuid
  workspaceId String @db.Uuid
  userId      String @db.Uuid

  /// 最後に読んだメッセージの id。**戻さない**（10.1）。
  lastReadMessageId String @db.Uuid

  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  dm         Dm         @relation(fields: [dmId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  membership Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  /// DM ごと消えるときは同じ文の中で消えるため NoAction にする（`ChannelRead.lastRead` と同じ理由）。
  lastRead   DmMessage  @relation(fields: [lastReadMessageId, dmId], references: [id, dmId], onDelete: NoAction)

  @@unique([dmId, userId])
  @@index([userId])
}

// ============================================================================
// 通知（F-26。機能一覧 10.3）
// ============================================================================

/// 受け取った通知（F-26。機能一覧 10.3）。**オフライン中に受けたメンションを、次にログインしたときに一覧で確かめるために残す**（要件定義書 3.5.2「通知の永続化」）。
///
/// - **行を作るのはメンションの対象を保存するのと同じトランザクション**（`notifications/mention-notifications.ts`）。書き手本人には作らない
/// - **編集で本文から外した対象の行は消し、足した対象の行は作る**（`MessageMention` に揃える）。本文に残した対象の行は既読のまま残す
/// - **既読は行ごとの `readAt` で持つ**。チャンネルの既読位置（F-23）とは別系統である
///
/// **踏むと壊れる: 一覧と既読化は、いまそのチャンネルの参加者である行だけを返す**（`ChannelMember` との結合。CLAUDE.md 2）。
/// **チャンネル単位のキック・退出では、この行は消えない**（`ChannelMember` だけが消える）——参加の条件を外すと、
/// 抜けたプライベートチャンネルの本文が通知の一覧から読める。
/// **削除済みのメッセージの行も返さない**（行は残す。メッセージは論理削除である）。
model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  /// 受け取った利用者。
  userId String @db.Uuid

  workspaceId String @db.Uuid

  /// メッセージが属するチャンネル。`Message` の複合一意 `(id, channelId)` を参照するために持つ。
  channelId String @db.Uuid

  messageId String @db.Uuid

  kind NotificationKind

  /// 既読にした時刻。未読なら null。**一度入れたら変えない**（2回目の既読化で時刻を進めない）。
  readAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  membership Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  channel    Channel    @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  /// メッセージは論理削除だけで消える。チャンネルごと消えるときは同じ文の中で消えるため NoAction にする（`ChannelRead` と同じ）。
  message    Message    @relation(fields: [messageId, channelId], references: [id, channelId], onDelete: NoAction)

  /// 同じメッセージの同じ種類の通知は1人1件（本文に同じ利用者を2回書いても1件）。
  @@unique([messageId, userId, kind])
  /// 一覧は利用者ごとに新しい順（`id` の降順）で引く。
  @@index([userId, id(sort: Desc)])
}

// ============================================================================
// ピン留め（F-33。機能一覧 13.2）
// ============================================================================

/// チャンネルにピン留めしたメッセージ（F-33。区分: 提案・承認済〔2026-09-03〕）。**1件のメッセージに1つまで**（`messageId` の一意制約）。
/// **外せるのはそのチャンネルの参加者なら誰でもよい**ため、ピン留めした人は表示のためだけに持つ（判定に使わない）。
/// **削除済みのメッセージの行も消さない**（削除は論理削除。一覧で返さないだけである）。
model MessagePin {
  /// UUIDv7 の代理キー（主キーの形を全モデルでそろえる。要件定義書 3.5.2）。**一覧の並び（ピン留めした新しい順）にも使う。**
  id String @id @default(uuid(7)) @db.Uuid

  messageId String @unique @db.Uuid

  /// メッセージが属するチャンネル。**messageId から導けるが、あえて持つ**——チャンネルのピン留めの一覧をこの列で引き、
  /// 下の複合外部キーで、別のチャンネルのメッセージを指せない。
  channelId String @db.Uuid

  /// ピン留めした人（`User.id`）。利用者は論理削除で行が残る（機能一覧 1.5）。
  pinnedById String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message  Message @relation(fields: [messageId, channelId], references: [id, channelId], onDelete: Cascade)
  pinnedBy User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  /// **チャンネルのピン留めの一覧はこの向きで引く**（`channelId = ?` を新しい順）。
  @@index([channelId, id])
}

/// アップロードの段（機能一覧 11.1）。発行 → 確定の途中 → 成功か拒否。**確定は識別子ごとに1回だけ行う**——
/// 発行の直後の行だけを「確定の途中」へ条件付きで進め、進められた要求だけが S3 を読み書きする。2回目以降は結果の列を返す。
enum UploadState {
  ISSUED
  COMPLETING
  SUCCEEDED
  REJECTED
}

/// アバター画像のアップロード（F-04。機能一覧 1.3・11.1）。発行した署名付き URL 1つに1行。
///
/// **キーは列に持たず、この行から組み立てる**——隔離用のキーは `quarantine/avatars/{userId}/{id}/{fileName}`、
/// 配信用のキーは `avatars/{userId}/{id}/{deliveredFileName}`（`apps/api/src/file-uploads/upload-keys.ts`）。
/// **確定を求められるのは `userId` の本人だけであり、キーは要求の値ではなくこの行から作る**（11.1）。
model AvatarUpload {
  /// アップロードの識別子であり、キーの `{UUID}` でもある（推測できない値。UUIDv7）。
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid

  /// 保存名（利用者のファイル名を許可リストで置き換え、隔離用のキーが 1,024 バイトに収まるよう切り詰めたもの。拡張子は付け替える前）。
  fileName String

  /// 申告した Content-Type（署名付き URL に焼き込んだ値。確定の検証では信用しない）。
  contentType String

  state UploadState @default(ISSUED)

  /// 確定に成功したときの、拡張子を検証した形式のものに付け替えた保存名。
  deliveredFileName String?

  /// 確定で断ったときの状態コードと `code`（2回目以降の確定に同じものを返す）。
  rejectedStatus Int?
  rejectedCode   String?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// チャンネルの添付ファイルのアップロード（F-27・F-28。機能一覧 11.1）。発行した署名付き URL 1つに1行。
///
/// **キーは列に持たず、この行から組み立てる**——隔離用のキーは `quarantine/workspace/{workspaceId}/channel/{channelId}/{id}/{fileName}`、
/// 配信用のキーは `workspace/{workspaceId}/channel/{channelId}/{id}/{deliveredFileName}`（`apps/api/src/file-uploads/upload-keys.ts`）。
/// **確定を求められるのは `uploaderId` の本人だけであり、キーとやり直す参加者判定の対象チャンネルは要求の値ではなくこの行から作る**（11.1。#211）。
/// **DM の添付にこの行とキーの構造を流用しない**（11.1 の冒頭。#239）。
model Attachment {
  /// アップロードの識別子であり、キーの `{UUID}` でもある（推測できない値。UUIDv7）。
  id String @id @default(uuid(7)) @db.Uuid

  /// 参加者判定を通したチャンネルとそのワークスペース（複合外部キーで、別のワークスペースのチャンネルを指せない）。
  workspaceId String @db.Uuid
  channelId   String @db.Uuid

  uploaderId String @db.Uuid

  /// 利用者が付けた元のファイル名（表示用。保存名には使わない。11.1）。
  originalName String

  /// 保存名（許可リストで置き換え、隔離用のキーが 1,024 バイトに収まるよう切り詰めたもの。拡張子は付け替える前）。
  fileName String

  /// 申告した Content-Type（署名付き URL に焼き込んだ値。確定の検証では信用しない）。
  contentType String

  state UploadState @default(ISSUED)

  /// 確定に成功したときの、検証した形式（共有の許可リストの id）・拡張子を付け替えた保存名・大きさ（バイト）。
  formatId          String?
  deliveredFileName String?
  size              Int?

  /// 確定で断ったときの状態コードと `code`（2回目以降の確定に同じものを返す）。
  rejectedStatus Int?
  rejectedCode   String?

  /// 結び付けた投稿。**確定に成功した、まだどの投稿にも付いていない、本人が上げたものだけを、同じチャンネルの投稿に付ける**（書く側が確かめる）。
  /// 投稿は同じチャンネルのものだけ（複合外部キー）。
  messageId String? @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  channel  Channel  @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId, channelId], references: [id, channelId], onDelete: NoAction)

  @@index([uploaderId])
  @@index([channelId])
  /// 一覧のメッセージに載せる添付を、メッセージの id でまとめて引く。
  @@index([messageId])
}
