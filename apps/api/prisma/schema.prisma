// Prisma のスキーマ。
//
// このファイルが定義するのは **認証・ワークスペース・チャンネルの土台**である。
// メッセージ・スレッド・リアクション・メンション・添付・検索は別のイシューで扱う。
//
// ============================================================================
// このファイルを直す人へ: **Prisma の記法で書けない制約が4つある**
// ============================================================================
//
// 部分一意索引（`WHERE` 付き）・式に対する索引（`lower(...)`）・検査制約（CHECK）は
// Prisma のスキーマ言語に無い。
// **マイグレーションの SQL に直接書いてある。** 具体的には次の4つ。
//
//   1. `User_userId_lower_key`                 … ユーザーID の一意性は大文字小文字を区別しない
//   2. `Membership_single_owner_per_workspace` … 1ワークスペースにオーナーは1人
//   3. `RecoveryCode_single_unused_per_user`   … 未使用のリカバリーコードは1人1つ
//   4. `Channel_archive_naming_check`          … アーカイブと採番と改名が不可分
//
// **このファイルだけを見ても、この4つは見えない。** モデルを増減させるときは
// `prisma/migrations/` の SQL も併せて読むこと。4つとも
// `apps/api/src/prisma-schema.test.ts` が実際の PostgreSQL に対して検証している。
//
// 代償: 上の4つは `prisma migrate dev` の自動生成では復元されない。
// スキーマを作り直すときは手で書き足す必要がある。
// 採らなかった側（制約をアプリ側の実装だけで守る）の代償は、
// **片方だけ実行された状態を DB が受け入れてしまう**ことである。
// 認可と整合性の根拠をアプリ側だけに置かない（CLAUDE.md 2）。

datasource db {
  provider = "postgresql"
  // **接続先はここに書けない。** Prisma 7 は datasource の `url` を廃止した。
  // 接続先はリポジトリの根の prisma.config.ts が渡す。
}

// 生成物は追跡しない（.gitignore の `**/generated/**`）。
// **生成は `npm run typecheck` と `npm run build` の前に走る**（ルートの package.json の
// `pretypecheck` / `prebuild`）。CI はその両方を実行するため、
// **生成器の設定が壊れていれば CI で落ちる。**
//
// `postinstall` に置かない。`prisma` は開発依存であり、`npm ci --omit=dev` でも
// `postinstall` は走るため、**開発依存を入れない構成ではインストール自体が失敗する。**
// 代償: `npm ci` しただけでは生成物ができない。**型を使う前に typecheck か build を
// 一度通す必要がある。** 生成を build の一部と見なす、という整理である。
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS の出力は CommonJS（apps/api/tsconfig.json）。
  // 生成物だけ ESM にすると、読み込む側で解決できない。
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// ============================================================================
// 列挙
// ============================================================================

/// ワークスペースにおける役割（要件定義書 3.5.1）。
/// オーナーは作成者に固定し、委譲もワークスペースの削除も行わない（3.4）。
enum WorkspaceRole {
  OWNER
  MEMBER
}

/// チャンネルの公開範囲（機能一覧 F-10）。
/// **PRIVATE の可視性は ChannelMember の有無で決まる。** この列だけでは決まらない。
enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

// ============================================================================
// 利用者
// ============================================================================

model User {
  /// 主キーはすべて UUIDv7（要件定義書 3.5.2）。
  ///
  /// **連番を用いないのは、連番そのものが「その資源が存在すること」を漏らすため**である。
  /// 生成は Prisma 側で行う。PostgreSQL 17 には組み込みの `uuidv7()` が無く
  /// （18 で追加）、DB 側の関数に依存すると 17 では動かない（技術スタック）。
  /// UUIDv4 ではなく v7 を使うのは、**先頭が時刻順で索引の局所性を損なわない**ため。
  id String @id @default(uuid(7)) @db.Uuid

  /// ログイン識別子であり、メンションの `@` に続く識別子でもある（機能一覧 1.1）。
  /// 文書では「ユーザーID」と呼ぶ。
  ///
  /// **Prisma 側の名前だけを `loginId` にし、DB の列名は `userId` のまま
  /// （`@map`）にしてある。** マイグレーションの SQL も `docs/features.md` の記述も
  /// 変わらない。名前を分ける理由は次のとおり。
  ///
  /// `RecoveryCode` / `Membership` / `ChannelMember` の `userId` は
  /// **`User.id`（UUID）への外部キー**であり、これとは別物である。
  /// 生の SQL なら `uuid = character varying` で落ちて気づくが、
  /// **Prisma のクライアントでは両方とも TypeScript の `string` になり、
  /// 取り違えても型検査を素通りする。**
  ///
  ///     prisma.membership.findMany({ where: { userId: session.user.loginId } })
  ///
  /// のような取り違えは、例外も型エラーも出さず**静かに0件を返す。**
  /// 「参加者一覧が空」「所属ワークスペースが無い」という形でしか現れない。
  /// **この PR にはまだ実装が1行も乗っていないため、分けるなら今が最も安い。**
  ///
  /// **退会しても再利用させない**（機能一覧 1.5）。退会は論理削除であり行が残るため、
  /// この一意制約がそのまま再利用の禁止になる。**別途の予約表は要らない。**
  ///
  /// 長さの上限（30文字。機能一覧 1.1）は**列の型に入れる。**
  /// 要件が数値で決めているものを、アプリ側の検証だけに置かない。
  /// **検証を1箇所書き漏らせば、そのまま無制限の文字列が入る**（REVIEW.md 3 / CWE-770）。
  /// 下限（3文字）と文字種（英数字とアンダースコア）は列では表せないため、アプリ側で見る。
  ///
  /// **この `@unique` は、一意性の根拠ではない。** 既定の照合順序で作られるため
  /// `owner` と `Owner` を別物として通す。**一意性を担保しているのは、マイグレーションに
  /// 手書きした `User_userId_lower_key`（`lower("userId")` の一意索引）である**
  /// （機能一覧 1.1。2026-09-05 決定）。ここに `@unique` を残しているのは、
  /// **このファイルだけを読む人に「ユーザーID は一意である」が見えなくなるため**である。
  ///
  /// **照合する側も `lower()` で引くこと。** 列は登録時の綴りをそのまま保持するため、
  /// 素の等値比較では、登録時と違う綴りで引けない。
  ///
  /// **この照合は Prisma のクライアントでは書けない。**
  /// このファイルの冒頭に挙げた4つの制約と同じ理由である
  /// （Prisma のスキーマ言語・問い合わせ API に `lower(...)` の等値比較が無い）。
  ///
  ///   - `findUnique({ where: { loginId } })` は**完全一致**であり、
  ///     `User_userId_lower_key` を使わない。**書いた側からは「素の等値比較」だと
  ///     見分けがつかない。** 型検査も通る。症状はログインの失敗とメンションの不着で、
  ///     どちらも**理由が利用者に返らない**（機能一覧 1.2 / 9.1）
  ///   - `mode: 'insensitive'` は、PostgreSQL 向けに **`ILIKE` を生成する**（Prisma の仕様）。
  ///     **`ILIKE` は `lower("userId")` の B-tree 式索引を使えない。**
  ///     結果は正しいが全表走査になり、利用者数に比例して遅くなる（REVIEW.md 5）。
  ///     **この遅さはこのリポジトリでは未計測である**（索引が使えないことは
  ///     式索引の性質であり、計測を要しない）
  ///
  /// **実装は `$queryRaw` で `lower("userId") = lower($1)` と書くこと。**
  /// 値はプレースホルダとして渡す（REVIEW.md 3 / CWE-89）。
  /// `nextArchiveSequence` / `visibleChannels` と同じ扱いである。
  ///
  /// **この雛形をそのまま写さないこと。`deletedAt` の扱いが経路ごとに違う。**
  /// 退会は論理削除でこの表の行が残るため、**素の照合は退会済みにも当たる。**
  ///
  ///   | 経路 | 退会済み | 落とすとどうなるか |
  ///   |---|---|---|
  ///   | ログイン（1.2） | **除く**（`AND "deletedAt" IS NULL`） | 退会したアカウントでログインできる |
  ///   | 招待（2.2） | **除く** | 招待し直せて `Membership` が復活する |
  ///   | 復旧（1.1） | **除く** | **退会済みのパスワードを書き換えられる** |
  ///   | メンション（9.1） | **当てる** | 過去のメンションの参照先を解決できず、会話が読めない |
  ///
  /// **復旧の経路は特に注意する。** 1.5 の「削除後、リカバリーコードによる
  /// 再設定もできない」を支えているのは「退会処理が同一トランザクションで
  /// `usedAt` を埋める」という規約だけであり、**退会処理が1件でも
  /// 取りこぼせば通ってしまう。** 読み取り側にも条件を置いて二重にする。
  /// この経路差は `apps/api/src/prisma-schema.test.ts` が固定している。
  loginId String @unique @db.VarChar(30) @map("userId")

  displayName String

  /// **Argon2id のハッシュだけを入れる列**（要件定義書 4.3）。
  /// 平文・可逆暗号の列は作らない。**ハッシュ化の実装はこのイシューの範囲外**であり、
  /// `argon2` の依存も入れていない。認証の実装時に導入する。
  passwordHash String

  /// プロフィール（機能一覧 1.3）。未設定を許すため任意にする。
  ///
  /// `statusText` の上限（100文字）は loginId と同じ理由で列の型に入れる。
  ///
  /// **`displayName` / `avatarUrl` には上限を置かない。**
  /// 機能一覧が数値を定めていないためである。**根拠の無い数字を列に焼き付けると、
  /// 後から変えるのにマイグレーションが要る。** 上限を決めたらここに入れる。
  ///
  /// **代償**（CLAUDE.md 4）**: この2つは DB が止めない。**
  /// `loginId` / `statusText` と違い、**アプリ側の検証を1箇所書き漏らせば、
  /// そのまま無制限の文字列が入る**（REVIEW.md 3 / CWE-770）。
  /// しかも `displayName` と `avatarUrl` は**メッセージ一覧を返すたびに載る列**であり、
  /// 影響は保存量だけに留まらない。**上限を決めるなら機能一覧 1.3 に承認を得て記し、
  /// ここに `@db.VarChar(n)` を置くこと。**
  /// `Workspace.name` / `Channel.name` / `Channel.baseName` も同じ扱いである
  /// （`Channel` 側は索引に載るため、別の事実上の上限がある。`name` の説明を参照）。
  ///
  /// **`statusEmoji` は理由が違う。** 機能一覧 1.3 は「ステータスは**絵文字1つ**と
  /// テキスト（最大100文字）で構成される」と**数を定めている。**
  /// それでも列に置かないのは、**「絵文字1つ」を文字数で表せない**ためである。
  /// ZWJ による連結や異体字セレクタで、1つの絵文字が複数のコードポイントになる。
  /// `VARCHAR(n)` に置き換えると、n をいくつにしても
  /// **正しい絵文字を弾くか、絵文字でない文字列を通すかのどちらかになる。**
  /// よってアプリ側で見る。**「機能一覧に数値が無い」を理由にしない。**
  avatarUrl   String?
  statusEmoji String?
  statusText  String? @db.VarChar(100)

  /// 退会（F-36）。**物理削除は行わない**（要件定義書 3.4）。
  ///
  /// 代償: **利用者が「削除した」と認識した内容も DB に残り続ける。**
  /// 過去のメッセージを残して会話の文脈を保つことと引き換えである。
  /// 実運用で削除の求めに応じるには、物理削除の仕組みが別途要る（要件定義書 6.2）。
  ///
  /// **この列を埋めるだけでは足りない。** 退会は論理削除でこの行が残るため、
  /// **`User` を参照する `ON DELETE CASCADE` はどれも発火しない。**
  /// 退会の処理は、**同一トランザクションで次の2つを行うこと**（機能一覧 1.5）。
  ///
  ///   1. 未使用の `RecoveryCode` を無効化する（`usedAt` を埋める）。
  ///      でないと**退会済みのアカウントを復旧できてしまう**
  ///   2. その利用者の `Membership` を消す。**`ChannelMember` は複合外部キーで
  ///      連鎖して消える**（`Membership.channelMembers` を参照）。
  ///      でないと**退会した利用者が参加者一覧と配信の対象に残り続ける**
  ///
  /// **どちらも DB は止めない。アプリ側が守る規約である。**
  /// 代償: 2 により、**退会後に「誰がいたか」を追えない**（物理削除の代償が退会にも及ぶ）。
  ///
  /// **その前に、オーナーの退会そのものを拒否すること**（機能一覧 1.5）。
  /// 2 をそのまま実行すると、**そのワークスペースはオーナーが0人になる。**
  /// `Membership_single_owner_per_workspace` は重複を止める索引であって、
  /// **不在は止めない。** オーナー権限の委譲もワークスペースの削除も対象外のため
  /// （要件定義書 3.4）、0人になったワークスペースは**二度と管理できなくなる。**
  /// **この拒否もアプリ側が守る規約である。DB は止めない。**
  deletedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// **この列だけは DB が担保しない。**
  ///
  /// `@updatedAt` は **Prisma のクライアント経由の更新でしか作用しない。**
  /// マイグレーションが作るのは `DEFAULT CURRENT_TIMESTAMP` だけであり、
  /// **更新時に値を進めるトリガは無い。**
  ///
  /// このスキーマは、一意性・検査制約・連鎖削除をすべて DB に置いている。
  /// **この列はその方針から外れる唯一のものである**（CLAUDE.md 4）。
  /// 代償: **生 SQL の `UPDATE` では据え置かれる。**
  /// チャンネルのアーカイブ（採番と改名）は生 SQL を想定しているため、
  /// **その経路で更新した行の `updatedAt` は進まない。**
  ///
  /// トリガを置かなかった理由: **現時点でこの列に依存する要求が1つも無い。**
  /// 置くなら `BEFORE UPDATE` のトリガを手書きし、このファイル冒頭の
  /// 「Prisma の記法で書けない制約」の一覧を4つから5つに増やすことになる。
  /// **この列を根拠に何かを判定する要求が出たら、その時点で見直すこと。**
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  recoveryCodes RecoveryCode[]

  /// **`ChannelMember` への直接の関連は持たない。** チャンネル参加は
  /// ワークスペース参加（`Membership`）を経由してのみ成り立つ（`ChannelMember` を参照）。
}

/// パスワードを忘れたときの唯一の復旧手段（F-37）。
///
/// メール送信を行わない構成の帰結であり、**このコードを失えばアカウントは復旧できない**
/// （要件定義書 3.4）。その代償は登録画面に明示する。
model RecoveryCode {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// **Argon2id のハッシュだけを入れる列**（機能一覧 1.1）。コード自体は保存しない。
  ///
  /// ハッシュは毎回ソルトが変わるため、**この列に一意制約は置けない**し、
  /// 値による検索もできない。照合は userId で絞ってから1件ずつ検証する。
  codeHash String

  /// **無効化した時刻。** 使い捨てであり、使用したコードは無効化する（機能一覧 1.1）。
  ///
  /// **「使用した時刻」ではない。** 入る経路は2つある。
  ///
  ///   1. リカバリーコードで実際にパスワードを再設定した
  ///   2. **利用者が退会した**（機能一覧 1.5）。退会は論理削除で `User` の行が残るため、
  ///      `ON DELETE CASCADE` は働かない。**削除と同一トランザクションで
  ///      未使用のコードを無効化する**ことで、退会済みアカウントの復旧を止める
  ///
  /// **この列から「復旧が行われたか」は読み取れない。**
  /// `usedAt IS NOT NULL` を「復旧が行われた」と読む実装を書いてはならない。
  /// **退会しただけの利用者が「復旧した」ことになる。**
  /// この列を根拠にできるのは「**そのコードはもう使えない**」ことだけである。
  ///
  /// 代償: 真偽値ではなく時刻にした当初の利点（いつ復旧が行われたかが分かる）は、
  /// 2つ目の経路を入れた時点で失われた。**復旧の履歴が要るなら、別に記録が要る。**
  /// それでも時刻のままにしているのは、**「いつ無効化されたか」は依然として
  /// 追える**ためで、真偽値に落とすと分かることが減るだけだからである。
  usedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 照合は userId で絞り込む。索引が無いと利用者数に比例して遅くなる。
  @@index([userId])
}

// ============================================================================
// ワークスペース
// ============================================================================

model Workspace {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  memberships Membership[]
  channels    Channel[]

  /// ワークスペース名に一意制約を置かない。**誰でも作成できる**（要件定義書 3.5.1）以上、
  /// 名前を取り合う設計にすると、先に作った人が名前を占有する。
  /// 識別は id で行い、名前は表示のためのものとする。
}

/// ワークスペースへの参加（第1層。要件定義書 3.5.1）。
///
/// **オーナーを Workspace.ownerId として別に持たない。** 役割はこの表の `role` だけを
/// 根拠とする。2箇所に持つと、片方だけ更新された状態が生まれ、
/// **どちらが正しいかを実行時まで判定できない。**
///
/// 「オーナーが1人だけ」は部分一意索引 `Membership_single_owner_per_workspace` が
/// マイグレーションの SQL で担保する。
///
/// 代償: **「オーナーが0人のワークスペース」は DB だけでは禁止できない。**
/// 索引が止められるのは重複であって不在ではない。ワークスペースの作成時に、
/// オーナーの Membership を**同一トランザクションで**作る必要がある。
///
/// 招待の未承諾（F-38）はこの表では表さない。**この表は成立した参加だけを持つ。**
/// 承諾していない招待は参加ではなく、参加として持つと
/// 「所属していないのに一覧に出る」経路をこちらから作ることになる。
/// 招待そのものは F-08 / F-38 のイシューで別のモデルとして扱う。
model Membership {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid
  userId      String @db.Uuid

  role WorkspaceRole

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// **この行が消えると、その利用者のチャンネル参加もすべて消える。**
  /// キック・退出が全チャンネルからの離脱になることを、DB が担保する。
  ///
  /// **ただし、退会（F-36）ではこの行は自動では消えない。** 退会は論理削除であり
  /// `User` の行が残るため、上の `onDelete: Cascade` が発火しないためである。
  /// **退会の処理が、同一トランザクションでこの行を消すこと**（機能一覧 1.5。
  /// `User.deletedAt` の説明を読むこと）。消さないと、
  /// **退会した利用者が参加者一覧と配信の対象に残り続ける。**
  channelMembers ChannelMember[]

  /// 同じ利用者が同じワークスペースに二重に参加しないこと。
  /// この索引は「そのワークスペースの参加者一覧」の取得にも効き、
  /// `ChannelMember` の複合外部キーの参照先にもなる。
  @@unique([workspaceId, userId])
  /// 「その利用者が所属するワークスペースの一覧」（サイドバーの切替）に効く。
  @@index([userId])
}

// ============================================================================
// チャンネル
// ============================================================================

/// チャンネル（第2層。要件定義書 3.5.1）。
///
/// ## アーカイブ時に名前へ採番する（提案・承認済。2026-09-04）
///
/// チャンネルは削除せずアーカイブする（F-35）。アーカイブしたチャンネルが名前を
/// 抱えたままだと、**同じ名前で新しいチャンネルを作れない。**
/// そこでアーカイブの時点で `name` を `baseName-<採番>` に変える。
///
/// **採番は二度と外れない。** アーカイブを解除しても元の名前には戻らない。
/// これにより `(workspaceId, name)` の一意制約を維持したまま、名前の衝突が
/// 構造的に起きなくなる。**ただしこれを DB は担保していない**
/// （`archiveSequence` の説明を読むこと）。
///
/// **復元した行は「採番済みだが archivedAt が null」という形になる。**
/// これは異常ではなく、復元されたチャンネルの正しい姿である。
/// 採番の有無を「アーカイブ中かどうか」の判定に使ってはならない。**判定は archivedAt で行う。**
///
/// **代償を記録する**（CLAUDE.md 4）。
///
/// 1. **アーカイブを解除しても名前が戻らないため、利用者からは「別のチャンネルに
///    なった」ように見える。** 復元は名前の復元ではない
/// 2. **過去のメンションやリンク、外部に共有された参照が指す名前と、現在の名前がずれる。**
///    参照が id で解決されていれば辿れるが、名前で書かれたものは辿れない
///
/// アーカイブ・採番・改名の3つが同時に起きることは、検査制約
/// `Channel_archive_naming_check` がマイグレーションの SQL で担保する。
/// **アプリ側の実装に委ねると、片方だけ実行された状態が作れてしまう。**
model Channel {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid

  /// 現在の名前。アーカイブすると `baseName-<archiveSequence>` に変わる。
  ///
  /// **列に長さの上限を置かない。** 機能一覧 3.1 が数値を定めていないためである
  /// （`loginId` / `statusText` とはここが違う）。
  ///
  /// **ただし「上限が無い」という意味ではない。** この列は一意索引
  /// `Channel_workspaceId_name_key`（B-tree）に載っており、
  /// **B-tree の索引タプルには約 2704 バイトの上限がある。**
  /// 超える名前の INSERT は
  /// `index row size ... exceeds btree version 4 maximum 2704 for index` で落ちる。
  /// **アプリ側の検証を通り抜けた入力が、400 ではなく 500 になる。**
  ///
  /// **この事実上の上限は文字数では表せない。** 索引タプルの値は行の外に出せない
  /// （TOAST できない）が、インラインでの圧縮は効くため、**同じ文字数でも中身によって
  /// 通ったり落ちたりする。** 実測（`apps/api/src/prisma-schema.test.ts`）では、
  /// 同じ 6000 文字でも `x` の繰り返しは通り、乱数の16進文字列は落ちる。
  ///
  /// よって **チャンネル名の長さはアプリ側で先に弾くこと。**
  ///
  /// **上限は「接尾辞を付けても収まる長さ」で決めること。**
  /// アーカイブは名前を `baseName-<archiveSequence>` に変えるため数バイト伸びる。
  /// **INSERT は通るのにアーカイブの UPDATE だけが落ちる名前が存在する。**
  /// 改名の機能は無いため、**そのチャンネルは永久にアーカイブできない**（F-35 は Must）。
  /// `archiveSequence` が `MAX + 1` を却下したのとまったく同じ形の失敗である。
  /// この帰結は `apps/api/src/prisma-schema.test.ts` が固定している
  /// （上限の数値は焼き付けず、入る最大の長さを実際に探してから確かめている）。
  /// **数値の上限を決めたら**（機能一覧 3.1 に承認を得て記す）、
  /// ここに `@db.VarChar(n)` を置き、この説明を置き換えること。
  ///
  /// `displayName` / `Workspace.name` にこの問題は起きない。**索引に載っていない。**
  name String

  /// 作成時に付けられた名前。採番の基底として使う。
  ///
  /// この列を持つのは、**採番の基底を name から文字列で切り出さないため**である。
  /// 切り出す方式では、利用者が `report-1` という名前を自分で付けた場合と、
  /// `report` をアーカイブして採番された場合を区別できない。
  ///
  /// 代償: 列が1つ増え、**作成時に name と baseName へ同じ値を書く必要がある。**
  /// ずれると採番の基底が狂う。ずれていないことは `Channel_archive_naming_check` が見る
  /// （採番されていない行は `name = baseName` でなければ通らない）。
  ///
  /// **この列を変えないことは、DB では担保していない。** 検査制約が禁じるのは
  /// name と baseName の**食い違い**だけであり、両方を同時に書き換える更新は通る。
  /// 通せば採番の基底が別の名前に移り、元の名前の採番列が飛ぶ。
  /// **これはアプリ側が守る規約である。**
  ///
  /// 止める制約を置かなかった理由: **チャンネルの改名機能を持たない**ため、
  /// 現時点で到達する経路が無い。止めるには行の更新前後を比べるトリガが要り、
  /// 到達経路の無い問題のために仕組みを1つ増やすことになる。
  /// **改名機能を足すときは、この判断を見直すこと。**
  ///
  /// 長さの上限を置かないのは name と同じ理由である。**この列自体は索引に載らないが、
  /// 検査制約が name = baseName（または `baseName-<採番>`）を要求するため、
  /// name の事実上の上限がそのままこの列にも及ぶ。** 上の name の説明を参照。
  baseName String

  visibility ChannelVisibility

  /// アーカイブした時刻（F-35）。null なら現役。
  archivedAt DateTime? @db.Timestamptz(3)

  /// 同じ基底名の中での通し番号。**一度アーカイブされた行が持つ。**
  /// 復元しても外れないため、**現役の行が持っていることもある**（上の説明を参照）。
  ///
  /// **既にこの列を持つ行を再びアーカイブするときは、採番も改名も行わない。**
  /// 規則をそのまま当てると、**自分自身が `general-1` を占有しているため 2 が選ばれ、
  /// 名前が `general-2` に変わる。** アーカイブと復元を繰り返すたびに番号が進み、
  /// 名前がずれ続ける。検査制約はこれを止めない（据え置きも採番し直しも通る）。
  /// 採番するのは**この列がまだ null の行だけ**である。
  ///
  /// 次の番号は「**その基底名で、名前がまだ空いている最小の番号**」とする。
  /// **`MAX(archiveSequence) + 1` にしてはならない。** チャンネル名に制限は無いため、
  /// 利用者が自分で `general-1` を作れる。その状態で `general` をアーカイブすると
  /// MAX + 1 は 1 を選び、**名前が衝突してアーカイブ自体が失敗する。**
  /// 改名の機能は無いため、そのチャンネルは**永久にアーカイブできない**（F-35 は Must）。
  ///
  /// 並行してアーカイブすると2つの操作が同じ番号を選びうる。
  /// **一意制約違反を捕まえて番号を進め、やり直すこと。**
  ///
  /// 番号の選び方を確かめる問い合わせは apps/api/src/prisma-schema.test.ts にある。
  /// **そのまま写さないこと。** テストは固定の文字列を連結しており、
  /// **baseName は利用者が付けた名前で `'` を含められる。**
  /// 実装ではプレースホルダとして渡す（REVIEW.md 3 / CWE-89）。
  ///
  /// **「採番が二度と外れない」ことは、DB では担保していない。**
  /// 検査制約が禁じるのは採番と名前の**食い違い**だけであり、
  /// `archiveSequence` と `name` を同時に戻す更新
  /// （`archiveSequence = NULL, name = baseName`）は通る。
  /// 元の名前が空いていれば一意制約にも触れない。
  /// **baseName の不変性と同じく、これはアプリ側が守る規約である。**
  ///
  /// 止める制約を置かなかった理由も baseName と同じである。
  /// **採番を外す経路（アーカイブの取り消し）を機能として持たない**ため、
  /// 現時点で到達しない。止めるには行の更新前後を比べるトリガが要り、
  /// 到達経路の無い問題のために仕組みを1つ増やすことになる。
  /// **アーカイブを取り消せる機能を足すときは、この判断を見直すこと。**
  archiveSequence Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// **この列だけは DB が担保しない。** 理由と代償は `User.updatedAt` に書いた。
  /// **この表では特に効く。** アーカイブの採番と改名は生 SQL を想定しており、
  /// `@updatedAt` は Prisma のクライアント経由でしか作用しないため、
  /// **アーカイブした行の `updatedAt` は据え置かれる。**
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ChannelMember[]

  /// ワークスペース内で名前は一意。**ワークスペースをまたげば同じ名前を使える。**
  /// 一意制約の範囲が広すぎないことは、テストが別ワークスペースへの作成で確かめている。
  ///
  /// **採番（workspaceId, baseName, archiveSequence）に別の一意制約は置かない。**
  /// 検査制約 `Channel_archive_naming_check` により、name は
  /// `baseName-<archiveSequence>` に一意に決まる。**採番が重複すれば名前も必ず重複する**ため、
  /// この一意制約だけで採番の重複も止まる。置いても届く場面が無く、
  /// テストで到達できない制約が1つ増えるだけになる。
  ///
  /// **`@@index([workspaceId])` も置かない。** この一意索引は先頭列が workspaceId の
  /// B-tree であり、「チャンネル一覧をワークスペース単位で引く」問い合わせにそのまま使える。
  /// 単独の索引は問い合わせ能力を1つも足さず、書き込みのたびの索引更新と容量だけを増やす。
  @@unique([workspaceId, name])
  /// **一意性のためではない。** id は主キーであり、これだけで一意である。
  /// `ChannelMember` の複合外部キー `(channelId, workspaceId)` の**参照先として要る**
  /// （PostgreSQL は一意制約の無い列の組を外部キーの参照先にできない）。
  @@unique([id, workspaceId])
}

/// チャンネルへの参加（第2層）。
///
/// **プライベートチャンネルの可視性の根拠はこの表である**（CLAUDE.md 2）。
/// 画面でボタンを隠すことは権限の根拠にならない。一覧・検索・ファイル配信・
/// WebSocket 配信のすべてが、この表との結合で参加者を判定する。
///
/// オーナーであっても、この表に行が無ければプライベートチャンネルの中身は見えない
/// （要件定義書 3.5.1 / 4.4）。**オーナーの権限は人の出入りの管理であって、
/// 会話の閲覧ではない。**
///
/// ## 参照先は User ではなく Membership である
///
/// **チャンネル参加は、ワークスペース参加の上にしか成り立たない。**
/// `userId` から `User` を直接参照すると、**ワークスペースからキック・退出した
/// 利用者の行がこの表に残り続ける。** この表だけで可視性を判定する実装がそれを拾えば、
/// **キックされた利用者がプライベートチャンネルを読み続けられる**
/// （機能一覧 2.2 の受け入れ条件「所属していた全チャンネルから自動的に外れる」
/// 「そのワークスペースのデータに一切アクセスできなくなる」が成立しない）。
///
/// そこで `workspaceId` を持たせ、`(workspaceId, userId)` で `Membership` を参照する。
/// **キック・退出（Membership の削除）が、そのまま全チャンネルからの離脱になる。**
/// 同時に、**ワークスペース外の利用者をプライベートチャンネルに招待できなくなる**
/// （機能一覧 2.2）。どちらもアプリ側の実装ではなく DB が担保する。
///
/// 代償: 列が1つ増え、`Channel` に `@@unique([id, workspaceId])` が要る
/// （複合外部キーの参照先には一意制約が要る）。主キーがある以上この索引は
/// 一意性の役には立たず、**参照先として使うためだけに存在する。**
///
/// 代償（削除の扱い）: **この表と `Membership` は物理削除である。**
/// 退出・キックの履歴は残らず、**「いつ誰が抜けたか」を後から追えない。**
/// 論理削除にすれば追えるが、可視性の判定すべてに「抜けていないこと」の条件が増え、
/// **1箇所でも書き漏らすと、抜けた利用者に見え続ける。** 追跡可能性より、
/// 判定を単純に保つことを採った（機能一覧 2.2）。
model ChannelMember {
  /// 複合主キー（channelId, userId）にせず、UUIDv7 の代理キーを置く。
  /// 主キーの形を全モデルでそろえるためであり、
  /// **「この表だけ例外」を覚えておく必要をなくす**（要件定義書 3.5.2）。
  id String @id @default(uuid(7)) @db.Uuid

  channelId String @db.Uuid

  /// チャンネルが属するワークスペース。**channelId から導けるが、あえて持つ。**
  /// 下の2本の複合外部キーの両方に要るためであり、
  /// 食い違いは `ChannelMember_channelId_workspaceId_fkey` が拒否する。
  workspaceId String @db.Uuid

  userId String @db.Uuid

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  /// チャンネルとワークスペースの組が実在すること。**食い違いを許さない。**
  channel Channel @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  /// **その利用者がそのワークスペースに参加していること。**
  /// User を直接参照しない。参照先を Membership にすることで、
  /// キック・退出がこの表まで連鎖する。
  membership Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  /// 二重参加を防ぐ。この索引は「そのチャンネルの参加者一覧」にも効く。
  @@unique([channelId, userId])
  /// **可視性の判定はこの向きで引く**（「この利用者が参加しているチャンネル」）。
  /// 索引が無いと、チャンネル一覧のたびに全走査になる。
  @@index([userId])
}
