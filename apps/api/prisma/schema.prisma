// Prisma のスキーマ。
//
// このファイルが定義するのは **認証・ワークスペース・チャンネルの土台**である。
// メッセージ・スレッド・リアクション・メンション・添付・検索は別のイシューで扱う。
//
// ============================================================================
// このファイルを直す人へ: **Prisma の記法で書けない制約が3つある**
// ============================================================================
//
// 部分一意索引（`WHERE` 付き）と検査制約（CHECK）は Prisma のスキーマ言語に無い。
// **マイグレーションの SQL に直接書いてある。** 具体的には次の3つ。
//
//   1. `Membership_single_owner_per_workspace` … 1ワークスペースにオーナーは1人
//   2. `RecoveryCode_single_unused_per_user`   … 未使用のリカバリーコードは1人1つ
//   3. `Channel_archive_naming_check`          … アーカイブと採番と改名が不可分
//
// **このファイルだけを見ても、この3つは見えない。** モデルを増減させるときは
// `prisma/migrations/` の SQL も併せて読むこと。3つとも
// `apps/api/src/prisma-schema.test.ts` が実際の PostgreSQL に対して検証している。
//
// 代償: 上の3つは `prisma migrate dev` の自動生成では復元されない。
// スキーマを作り直すときは手で書き足す必要がある。
// 採らなかった側（制約をアプリ側の実装だけで守る）の代償は、
// **片方だけ実行された状態を DB が受け入れてしまう**ことである。
// 認可と整合性の根拠をアプリ側だけに置かない（CLAUDE.md 2）。

datasource db {
  provider = "postgresql"
  // **接続先はここに書けない。** Prisma 7 は datasource の `url` を廃止した。
  // 接続先はリポジトリの根の prisma.config.ts が渡す。
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS の出力は CommonJS（apps/api/tsconfig.json）。
  // 生成物だけ ESM にすると、読み込む側で解決できない。
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// ============================================================================
// 列挙
// ============================================================================

/// ワークスペースにおける役割（要件定義書 3.5.1）。
/// オーナーは作成者に固定し、委譲もワークスペースの削除も行わない（3.4）。
enum WorkspaceRole {
  OWNER
  MEMBER
}

/// チャンネルの公開範囲（機能一覧 F-10）。
/// **PRIVATE の可視性は ChannelMember の有無で決まる。** この列だけでは決まらない。
enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

// ============================================================================
// 利用者
// ============================================================================

model User {
  /// 主キーはすべて UUIDv7（要件定義書 3.5.2）。
  ///
  /// **連番を用いないのは、連番そのものが「その資源が存在すること」を漏らすため**である。
  /// 生成は Prisma 側で行う。PostgreSQL 17 には組み込みの `uuidv7()` が無く
  /// （18 で追加）、DB 側の関数に依存すると 17 では動かない（技術スタック）。
  /// UUIDv4 ではなく v7 を使うのは、**先頭が時刻順で索引の局所性を損なわない**ため。
  id String @id @default(uuid(7)) @db.Uuid

  /// ログイン識別子であり、メンションの `@` に続く識別子でもある（機能一覧 1.1）。
  ///
  /// **退会しても再利用させない**（機能一覧 1.5）。退会は論理削除であり行が残るため、
  /// この一意制約がそのまま再利用の禁止になる。**別途の予約表は要らない。**
  userId String @unique

  displayName String

  /// **Argon2id のハッシュだけを入れる列**（要件定義書 4.3）。
  /// 平文・可逆暗号の列は作らない。**ハッシュ化の実装はこのイシューの範囲外**であり、
  /// `argon2` の依存も入れていない。認証の実装時に導入する。
  passwordHash String

  /// プロフィール（機能一覧 1.3）。未設定を許すため任意にする。
  avatarUrl   String?
  statusEmoji String?
  statusText  String?

  /// 退会（F-36）。**物理削除は行わない**（要件定義書 3.4）。
  ///
  /// 代償: **利用者が「削除した」と認識した内容も DB に残り続ける。**
  /// 過去のメッセージを残して会話の文脈を保つことと引き換えである。
  /// 実運用で削除の求めに応じるには、物理削除の仕組みが別途要る（要件定義書 6.2）。
  deletedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)

  memberships    Membership[]
  channelMembers ChannelMember[]
  recoveryCodes  RecoveryCode[]
}

/// パスワードを忘れたときの唯一の復旧手段（F-37）。
///
/// メール送信を行わない構成の帰結であり、**このコードを失えばアカウントは復旧できない**
/// （要件定義書 3.4）。その代償は登録画面に明示する。
model RecoveryCode {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// **Argon2id のハッシュだけを入れる列**（機能一覧 1.1）。コード自体は保存しない。
  ///
  /// ハッシュは毎回ソルトが変わるため、**この列に一意制約は置けない**し、
  /// 値による検索もできない。照合は userId で絞ってから1件ずつ検証する。
  codeHash String

  /// 使い捨て。使用したコードは無効化する（機能一覧 1.1）。
  ///
  /// 真偽値ではなく時刻にするのは、**いつ復旧が行われたかが分かるため**である。
  /// 列が増えるわけではなく、真偽値を選ぶ利点が無い。
  usedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 照合は userId で絞り込む。索引が無いと利用者数に比例して遅くなる。
  @@index([userId])
}

// ============================================================================
// ワークスペース
// ============================================================================

model Workspace {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  memberships Membership[]
  channels    Channel[]

  /// ワークスペース名に一意制約を置かない。**誰でも作成できる**（要件定義書 3.5.1）以上、
  /// 名前を取り合う設計にすると、先に作った人が名前を占有する。
  /// 識別は id で行い、名前は表示のためのものとする。
}

/// ワークスペースへの参加（第1層。要件定義書 3.5.1）。
///
/// **オーナーを Workspace.ownerId として別に持たない。** 役割はこの表の `role` だけを
/// 根拠とする。2箇所に持つと、片方だけ更新された状態が生まれ、
/// **どちらが正しいかを実行時まで判定できない。**
///
/// 「オーナーが1人だけ」は部分一意索引 `Membership_single_owner_per_workspace` が
/// マイグレーションの SQL で担保する。
///
/// 代償: **「オーナーが0人のワークスペース」は DB だけでは禁止できない。**
/// 索引が止められるのは重複であって不在ではない。ワークスペースの作成時に、
/// オーナーの Membership を**同一トランザクションで**作る必要がある。
///
/// 招待の未承諾（F-38）はこの表では表さない。**この表は成立した参加だけを持つ。**
/// 承諾していない招待は参加ではなく、参加として持つと
/// 「所属していないのに一覧に出る」経路をこちらから作ることになる。
/// 招待そのものは F-08 / F-38 のイシューで別のモデルとして扱う。
model Membership {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid
  userId      String @db.Uuid

  role WorkspaceRole

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 同じ利用者が同じワークスペースに二重に参加しないこと。
  /// この索引は「そのワークスペースの参加者一覧」の取得にも効く。
  @@unique([workspaceId, userId])
  /// 「その利用者が所属するワークスペースの一覧」（サイドバーの切替）に効く。
  @@index([userId])
}

// ============================================================================
// チャンネル
// ============================================================================

/// チャンネル（第2層。要件定義書 3.5.1）。
///
/// ## アーカイブ時に名前へ採番する（提案・承認済。2026-09-04）
///
/// チャンネルは削除せずアーカイブする（F-35）。アーカイブしたチャンネルが名前を
/// 抱えたままだと、**同じ名前で新しいチャンネルを作れない。**
/// そこでアーカイブの時点で `name` を `baseName-<採番>` に変える。
///
/// **採番は二度と外れない。** アーカイブを解除しても元の名前には戻らない。
/// これにより `(workspaceId, name)` の一意制約を維持したまま、名前の衝突が
/// 構造的に起きなくなる。
///
/// **代償を記録する**（CLAUDE.md 4）。
///
/// 1. **アーカイブを解除しても名前が戻らないため、利用者からは「別のチャンネルに
///    なった」ように見える。** 復元は名前の復元ではない
/// 2. **過去のメンションやリンク、外部に共有された参照が指す名前と、現在の名前がずれる。**
///    参照が id で解決されていれば辿れるが、名前で書かれたものは辿れない
///
/// アーカイブ・採番・改名の3つが同時に起きることは、検査制約
/// `Channel_archive_naming_check` がマイグレーションの SQL で担保する。
/// **アプリ側の実装に委ねると、片方だけ実行された状態が作れてしまう。**
model Channel {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @db.Uuid

  /// 現在の名前。アーカイブすると `baseName-<archiveSequence>` に変わる。
  name String

  /// 作成時に付けられた名前。**以後は変わらない。**
  ///
  /// この列を持つのは、**採番の基底を name から文字列で切り出さないため**である。
  /// 切り出す方式では、利用者が `report-1` という名前を自分で付けた場合と、
  /// `report` をアーカイブして採番された場合を区別できない。
  ///
  /// 代償: 列が1つ増え、**作成時に name と baseName へ同じ値を書く必要がある。**
  /// ずれると採番の基底が狂う。ずれないことは `Channel_archive_naming_check` が見る
  /// （アーカイブしていない行は `name = baseName` でなければ通らない）。
  baseName String

  visibility ChannelVisibility

  /// アーカイブした時刻（F-35）。null なら現役。
  archivedAt DateTime? @db.Timestamptz(3)

  /// 同じ基底名の中での通し番号。**アーカイブした行だけが持つ。**
  /// 次の番号は `MAX(archiveSequence) + 1`（同一ワークスペース・同一 baseName）で求める。
  archiveSequence Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ChannelMember[]

  /// ワークスペース内で名前は一意。**ワークスペースをまたげば同じ名前を使える。**
  /// 一意制約の範囲が広すぎないことは、テストが別ワークスペースへの作成で確かめている。
  ///
  /// **採番（workspaceId, baseName, archiveSequence）に別の一意制約は置かない。**
  /// 検査制約 `Channel_archive_naming_check` により、アーカイブ済みの name は
  /// `baseName-<archiveSequence>` に一意に決まる。**採番が重複すれば名前も必ず重複する**ため、
  /// この一意制約だけで採番の重複も止まる。置いても届く場面が無く、
  /// テストで到達できない制約が1つ増えるだけになる。
  @@unique([workspaceId, name])
  /// チャンネル一覧はワークスペース単位で引く。
  @@index([workspaceId])
}

/// チャンネルへの参加（第2層）。
///
/// **プライベートチャンネルの可視性の根拠はこの表である**（CLAUDE.md 2）。
/// 画面でボタンを隠すことは権限の根拠にならない。一覧・検索・ファイル配信・
/// WebSocket 配信のすべてが、この表との結合で参加者を判定する。
///
/// オーナーであっても、この表に行が無ければプライベートチャンネルの中身は見えない
/// （要件定義書 3.5.1 / 4.4）。**オーナーの権限は人の出入りの管理であって、
/// 会話の閲覧ではない。**
model ChannelMember {
  /// 複合主キー（channelId, userId）にせず、UUIDv7 の代理キーを置く。
  /// 主キーの形を全モデルでそろえるためであり、
  /// **「この表だけ例外」を覚えておく必要をなくす**（要件定義書 3.5.2）。
  id String @id @default(uuid(7)) @db.Uuid

  channelId String @db.Uuid
  userId    String @db.Uuid

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 二重参加を防ぐ。この索引は「そのチャンネルの参加者一覧」にも効く。
  @@unique([channelId, userId])
  /// **可視性の判定はこの向きで引く**（「この利用者が参加しているチャンネル」）。
  /// 索引が無いと、チャンネル一覧のたびに全走査になる。
  @@index([userId])
}
